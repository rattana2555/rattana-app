function renderHome(){
  const rows=filterRows(selectedPeriod,selectedWH);
  const{label}=getRange(selectedPeriod);
  const total=rows.reduce((s,r)=>({baht:s.baht+r.baht,cs:s.cs+r.cs,txn:s.txn+1}),{baht:0,cs:0,txn:0});
  const byCat={};TARGET_CATS.forEach(c=>byCat[c]={baht:0,cs:0,txn:0});
  rows.forEach(r=>{byCat[r.cat].baht+=r.baht;byCat[r.cat].cs+=r.cs;byCat[r.cat].txn++;});
  const topCat=TARGET_CATS.reduce((a,b)=>byCat[a].baht>byCat[b].baht?a:b);
  const m=CAT_META[topCat];
  let diff='—';
  const dp=prevPeriodRows();
  if(dp){const prev=dp.reduce((s,r)=>s+r.baht,0);const pct=prev?((total.baht-prev)/Math.abs(prev)*100):0;
    diff=`${pct>=0?'+':''}${pct.toFixed(1)}%`;$('heroDiff').className='hero-stat-val num '+(pct>=0?'up':'down');}
  $('heroDate').textContent=label;$('heroAmount').textContent=fmtBaht(total.baht);
  $('heroCs').textContent=fmtCs(total.cs);$('heroTxn').textContent=total.txn.toLocaleString();
  $('heroTopCat').textContent=m?m.icon+' '+(topCat.replace('Bplus ','').replace(' Al','')):'—';
  $('heroDiff').textContent=diff;

  // hero target bar
  const tgtByCat=getTargetByCat(selectedWH);
  const actByCat=getMonthActualByCat(selectedWH);
  const totalTgt=Object.values(tgtByCat).reduce((s,v)=>s+v,0);
  const totalAct=Object.values(actByCat).reduce((s,v)=>s+v,0);
  const hw=$('heroTargetWrap');
  if(totalTgt>0){
    hw.classList.add('show');
    const pct=Math.round(totalAct/totalTgt*100);
    const clr=pctClr(pct);
    $('heroTargetPct').textContent=pct+'%';$('heroTargetPct').style.color=clr;
    $('heroTargetBar').style.width=Math.min(pct,100)+'%';$('heroTargetBar').style.background=clr;
    const rem=totalTgt-totalAct;
    $('heroTargetSub').textContent=`฿${fmtBaht(totalAct)} จาก ฿${fmtBaht(totalTgt)} ${rem>0?'(เหลือ ฿'+fmtBaht(rem)+')':'✅ ถึงเป้าแล้ว!'}`;
  }else hw.classList.remove('show');

  // cat list
  $('catList').innerHTML=TARGET_CATS.map(cat=>{
    const meta=CAT_META[cat];const d=byCat[cat];
    const tgt=tgtByCat[cat]||0,act=actByCat[cat]||0;
    const pct=tgt>0?Math.round(act/tgt*100):0;
    const hasT=tgt>0;const rem=tgt-act;
    return `<div class="cat-item">
      <div class="cat-item-top">
        <div class="cat-icon" style="background:${meta.bg}">${meta.icon}</div>
        <div class="cat-info"><div class="cat-name">${cat}</div><div class="cat-txn">${d.txn.toLocaleString()} transactions</div></div>
        <div class="cat-amount">
          <div class="cat-baht num ${d.baht===0?'zero':''}">฿${fmtBaht(d.baht)}</div>
          <div class="cat-cs num">${fmtCs(d.cs)} ลัง</div>
        </div>
      </div>
      <div class="cat-target-section ${hasT?'show':''}">
        <div class="cat-target-row">
          <span class="cat-target-label">🎯 เป้าเดือนนี้</span>
          <span class="cat-target-pct num ${pctCls(pct)}">${pct}%</span>
        </div>
        <div class="cat-target-track"><div class="cat-target-bar" style="width:${Math.min(pct,100)}%;background:${pctClr(pct)}"></div></div>
        <div class="cat-target-txt num">฿${fmtBaht(act)} / ฿${fmtBaht(tgt)} ${rem>0?'· เหลือ ฿'+fmtBaht(rem):'· ✅ ถึงเป้า!'}</div>
      </div>
    </div>`;
  }).join('');
  renderMiniChart(getLast7Days());
}
function prevPeriodRows(){
  const t=new Date();t.setHours(0,0,0,0);
  if(selectedPeriod==='yesterday'){const d2=new Date(t);d2.setDate(d2.getDate()-2);
    return allRows.filter(r=>{if(selectedWH!=='all'&&r.wh!==selectedWH)return false;const d=parseTHDate(r.date);return d&&toISO(d)===toISO(d2);});}
  return null;
}
function getLast7Days(){
  const t=new Date();t.setHours(0,0,0,0);const result=[];
  for(let i=6;i>=0;i--){
    const d=new Date(t);d.setDate(d.getDate()-i);const ds=toISO(d);
    const sum=allRows.filter(r=>{if(selectedWH!=='all'&&r.wh!==selectedWH)return false;const rd=parseTHDate(r.date);return rd&&toISO(rd)===ds;}).reduce((s,r)=>s+r.baht,0);
    result.push({baht:sum,label:`${d.getDate()}/${d.getMonth()+1}`});
  }
  return result;
}
