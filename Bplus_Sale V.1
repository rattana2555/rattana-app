      scales:{x:{ticks:{color:'#8a9e8f',font:{size:10,family:'Sarabun'}},grid:{display:false},border:{display:false}},
              y:{ticks:{color:'#8a9e8f',font:{size:9,family:'Sarabun'},callback:v=>fmtBaht(v)},grid:{color:'rgba(0,0,0,.04)'},border:{display:false}}}}});
