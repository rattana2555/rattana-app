<script>
// ── Config ──────────────────────────────────────────────────
const GAS_URL       = 'https://script.google.com/macros/s/AKfycby4h3bvctWeLWRUCOy7VMtKhzxuCtWCYiFp_1HhCtTy_705TS2UmSpykZv9p01hkqc_IQ/exec';
const STOCK_GAS_URL = 'https://script.google.com/macros/s/AKfycbzps0d73Utoxo0vDBNQJhL6Wbcb3o4MuKx_gQufkPMU4r1QqproIAu2eCC8KE82HMdHlA/exec';
const SHEET_ID  = '1QIusvLuKv38mYDszVd093qzuD6DD8462QkZCTHpUw6s';
const SHEET_GID = '1606652398';
const TARGET_GID= '835856164';
const TARGET_CSV_URLS = [
  `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv&gid=${TARGET_GID}`,
  `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=Target`,
];
const CSV_URLS = [
  `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv&gid=${SHEET_GID}`,
  `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=SQLBP`,
];
const TARGET_CATS = ['Bplus FMCG','Bplus Thaibev Al','Bplus บุหรี่','F&N'];
const CAT_META = {
  'Bplus FMCG':      {icon:'🛒',color:'#1a6fb8',bg:'#e8f1fb'},
  'Bplus Thaibev Al':{icon:'🍺',color:'#f59e0b',bg:'#fef3cd'},
  'Bplus บุหรี่':     {icon:'🚬',color:'#ef4444',bg:'#fde8e8'},
  'F&N':             {icon:'🥛',color:'#00b14f',bg:'#e8f7ef'},
};
const WH_LIST=['W1','W2','W3','W4'];
const WH_META={W1:{lc:'wh-w1',bc:'bar-w1'},W2:{lc:'wh-w2',bc:'bar-w2'},W3:{lc:'wh-w3',bc:'bar-w3'},W4:{lc:'wh-w4',bc:'bar-w4'}};

// ── State ────────────────────────────────────────────────────
let allRows=[],stockRows=[],targetRows=[];
let selectedWH='all',selectedPeriod='yesterday',productSearch='';
let stockWH='all',stockSearch='',stockActiveCat=null,stockFilter='all';
let charts={};
let lastUpdated='',dataSourceLabel='Apps Script',stockSourceLabel='Stock GAS',targetSourceLabel='—';

// ── Helpers ──────────────────────────────────────────────────
const $=id=>document.getElementById(id);
function parseTHDate(s){if(!s)return null;const p=s.split('/');if(p.length!==3)return null;return new Date(+p[2],+p[1]-1,+p[0]);}
function toISO(d){return d?d.toISOString().split('T')[0]:'';}
function fmtBaht(n){if(Math.abs(n)>=1e6)return(n/1e6).toFixed(2)+'M';if(Math.abs(n)>=1e3)return n.toLocaleString('th-TH',{maximumFractionDigits:0});return n.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
function fmtBahtFull(n){return n.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
function fmtCs(n){return n.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
function showSpinner(t='โหลด...'){$('spinner').classList.add('show');$('spinTxt').textContent=t;}
function hideSpinner(){$('spinner').classList.remove('show');}
function toast(msg,type='ok'){const el=document.createElement('div');el.className=`toast toast-${type}`;el.textContent=msg;document.body.appendChild(el);setTimeout(()=>{el.style.opacity='0';el.style.transition='opacity .4s';setTimeout(()=>el.remove(),400)},2800);}
function pctCls(p){return p>=100?'pct-ok':p>=70?'pct-warn':'pct-low';}
function pctClr(p){return p>=100?'var(--green)':p>=70?'var(--amber)':'var(--red)';}

// ── Date / Filter ────────────────────────────────────────────
function getRange(period){
  const t=new Date();t.setHours(0,0,0,0);
  const y=new Date(t);y.setDate(y.getDate()-1);
  if(period==='today')return{from:toISO(t),to:toISO(t),label:'วันนี้ '+t.toLocaleDateString('th-TH',{day:'2-digit',month:'short',year:'2-digit'})};
  if(period==='yesterday')return{from:toISO(y),to:toISO(y),label:'เมื่อวาน '+y.toLocaleDateString('th-TH',{day:'2-digit',month:'short',year:'2-digit'})};
  if(period==='week'){const w=new Date(t);w.setDate(w.getDate()-6);return{from:toISO(w),to:toISO(t),label:'7 วันย้อนหลัง'};}
  if(period==='month'){const m=new Date(t.getFullYear(),t.getMonth(),1);return{from:toISO(m),to:toISO(t),label:'เดือนนี้'};}
  if(period==='year'){const yr=new Date(t.getFullYear(),0,1);return{from:toISO(yr),to:toISO(t),label:'ปีนี้ '+t.getFullYear()};}
  return{from:'',to:toISO(t),label:'ทั้งหมด'};
}
function filterRows(period,wh){
  const{from,to}=getRange(period);
  return allRows.filter(r=>{
    if(wh!=='all'&&r.wh!==wh)return false;
    if(from||to){const d=parseTHDate(r.date);if(!d)return false;const ds=toISO(d);if(from&&ds<from)return false;if(to&&ds>to)return false;}
    return true;
  });
}

// ── Target helpers ───────────────────────────────────────────
function getMonthActualByCat(wh){
  const t=new Date();t.setHours(0,0,0,0);
  const from=toISO(new Date(t.getFullYear(),t.getMonth(),1)),to=toISO(t);
  const byCat={};TARGET_CATS.forEach(c=>byCat[c]=0);
  allRows.forEach(r=>{
    if(wh!=='all'&&r.wh!==wh)return;
    const d=parseTHDate(r.date);if(!d)return;
    const ds=toISO(d);if(ds<from||ds>to)return;
    if(byCat[r.cat]!==undefined)byCat[r.cat]+=r.baht;
  });
  return byCat;
}
function getTargetByCat(wh){
  const byCat={};TARGET_CATS.forEach(c=>byCat[c]=0);
  targetRows.forEach(r=>{
    if(wh!=='all'&&r.wh&&r.wh!==wh)return;
    if(byCat[r.cat_bu]!==undefined)byCat[r.cat_bu]+=r.target;
  });
  return byCat;
}

// ── CSV Parser ───────────────────────────────────────────────
function parseCsvLine(line){
  const res=[];let cur='',inQ=false;
  for(let i=0;i<line.length;i++){
    const c=line[i];
    if(c==='"'&&!inQ){inQ=true;continue;}
    if(c==='"'&&inQ){if(line[i+1]==='"'){cur+='"';i++;}else inQ=false;continue;}
    if(c===','&&!inQ){res.push(cur.trim());cur='';continue;}
    cur+=c;
  }
  res.push(cur.trim());return res;
}

// ── Fetch Sales ──────────────────────────────────────────────
async function fetchData(){
  showSpinner('โหลดยอดขาย...');
  try{
    const res=await fetch(GAS_URL,{redirect:'follow'});
    if(!res.ok)throw new Error('HTTP '+res.status);
    const json=await res.json();if(json.error)throw new Error(json.error);
    allRows=json.rows.map(r=>({date:String(r.date||'').trim(),product:String(r.product||'').trim(),
      cat:String(r.cat||'').trim(),wh:String(r.wh||'').trim(),baht:Number(r.baht)||0,cs:Number(r.cs)||0}));
    lastUpdated=json.updated?new Date(json.updated).toLocaleString('th-TH'):'';
    dataSourceLabel='Apps Script ✅';hideSpinner();renderAll();
    toast(`ยอดขาย ${allRows.length.toLocaleString()} รายการ 🎉`);return;
  }catch(e){console.warn('GAS:',e.message);}
  for(let i=0;i<CSV_URLS.length;i++){
    try{
      $('spinTxt').textContent=`ลอง CSV ${i+1}...`;
      const res=await fetch(CSV_URLS[i],{redirect:'follow'});if(!res.ok)throw new Error('HTTP '+res.status);
      const txt=await res.text();if(!txt||txt.length<20)throw new Error('empty');
      parseSQLBP(txt);dataSourceLabel='CSV Direct';hideSpinner();renderAll();
      toast(`ยอดขาย ${allRows.length.toLocaleString()} รายการ`);return;
    }catch(e){console.warn('CSV'+i+':',e.message);}
  }
  hideSpinner();$('uploadOverlay').classList.add('show');
  toast('โหลดยอดขายไม่ได้ — กรุณาอัปโหลด CSV','err');
}
function parseSQLBP(text){
  const lines=text.split('\n').filter(l=>l.trim());if(lines.length<2)return;
  const headers=parseCsvLine(lines[0]);
  const ci={};headers.forEach((h,i)=>ci[h.replace(/\r/,'').trim()]=i);
  const dI=ci['Doc_Date']??0,pI=ci['Product_Name']??6,csI=ci['Sales_CS']??9,
        exI=ci['EXVat']??13,whI=ci['WH']??15,catI=ci['Cat_BU']??17;
  allRows=[];
  for(let i=1;i<lines.length;i++){
    const cols=parseCsvLine(lines[i]);
    const cat=(cols[catI]||'').replace(/\r/,'').trim();
    if(!TARGET_CATS.includes(cat))continue;
    allRows.push({date:(cols[dI]||'').trim(),product:(cols[pI]||'').trim(),cat,
      wh:(cols[whI]||'').trim(),baht:parseFloat(String(cols[exI]||'0').replace(/,/g,''))||0,
      cs:parseFloat(String(cols[csI]||'0').replace(/,/g,''))||0});
  }
  lastUpdated=new Date().toLocaleString('th-TH');
}

// ── Fetch Target ─────────────────────────────────────────────
async function fetchTarget(){
  for(let i=0;i<TARGET_CSV_URLS.length;i++){
    try{
      const res=await fetch(TARGET_CSV_URLS[i],{redirect:'follow'});
      if(!res.ok)throw new Error('HTTP '+res.status);
      const txt=await res.text();if(!txt||txt.length<10)throw new Error('empty');
      parseTargetCSV(txt);targetSourceLabel='CSV ✅';
      renderAll();toast(`เป้าหมาย ${targetRows.length.toLocaleString()} รายการ 🎯`);return;
    }catch(e){console.warn('Target '+i+':',e.message);}
  }
  targetSourceLabel='โหลดไม่ได้ ❌';renderProfile();
  toast('โหลด Target ไม่ได้ — อัปโหลด CSV ในโปรไฟล์','err');
}
function parseTargetCSV(text){
  text=text.replace(/^\uFEFF/,'');
  const lines=text.split('\n').filter(l=>l.trim());if(lines.length<2)return;
  const headers=parseCsvLine(lines[0]).map(h=>h.replace(/\r/,'').trim());
  const ci={};headers.forEach((h,i)=>ci[h]=i);
  const whI =ci['WH']??ci['wh']??-1;
  const catI=ci['Cat_BU']??ci['cat_bu']??ci['Cat']??-1;
  const tgtI=ci['Target']??ci['target']??ci['TARGET']??-1;
  targetRows=[];
  for(let i=1;i<lines.length;i++){
    const cols=parseCsvLine(lines[i]);
    const cat=(catI>=0?(cols[catI]||''):'').replace(/\r/,'').trim();
    if(!cat)continue;
    const tgt=parseFloat(String(tgtI>=0?(cols[tgtI]||'0'):'0').replace(/,/g,''))||0;
    targetRows.push({wh:whI>=0?(cols[whI]||'').replace(/\r/,'').trim():'',cat_bu:cat,target:tgt});
  }
}
function handleTargetCSV(input){
  const file=input.files[0];if(!file)return;
  showSpinner('อ่านไฟล์ Target...');
  const r=new FileReader();
  r.onload=e=>{parseTargetCSV(e.target.result);targetSourceLabel='CSV Upload ✅';
    hideSpinner();renderAll();toast(`เป้าหมาย ${targetRows.length.toLocaleString()} รายการ 🎯`);};
  r.readAsText(file,'UTF-8');
}

// ── Fetch Stock ──────────────────────────────────────────────
async function fetchStock(){
  if($('stockCatList'))$('stockCatList').innerHTML='<div class="loading-stock">⏳ กำลังโหลดสต็อก...</div>';
  try{
    const res=await fetch(STOCK_GAS_URL,{redirect:'follow'});if(!res.ok)throw new Error('HTTP '+res.status);
    const json=await res.json();if(json.error)throw new Error(json.error);
    stockRows=json.rows.map(r=>({name:String(r.name||'').trim(),cat_bu:String(r.cat_bu||'').trim(),
      w1:Number(r.w1)||0,w2:Number(r.w2)||0,w3:Number(r.w3)||0,w4:Number(r.w4)||0}));
    stockSourceLabel='Stock GAS ✅';renderStock();renderProfile();
    toast(`สต็อก ${stockRows.length.toLocaleString()} สินค้า 📦`);return;
  }catch(e){
    console.warn('Stock GAS:',e.message);stockSourceLabel='โหลดไม่ได้ ❌';
    if($('stockCatList'))$('stockCatList').innerHTML='<div class="empty">⚠️ โหลดสต็อกไม่ได้<br><small>อัปโหลด CSV ในโปรไฟล์</small></div>';
    if($('stockSource'))$('stockSource').textContent=stockSourceLabel;
    toast('โหลดสต็อกไม่ได้','err');
  }
}
function handleStockCSV(input){
  const file=input.files[0];if(!file)return;
  showSpinner('อ่านไฟล์ Stock...');
  const r=new FileReader();
  r.onload=e=>{parseStockCSV(e.target.result);stockSourceLabel='CSV Upload ✅';
    hideSpinner();renderStock();renderProfile();toast(`สต็อก ${stockRows.length.toLocaleString()} สินค้า 📦`);};
  r.readAsText(file,'UTF-8');
}
function parseStockCSV(text){
  text=text.replace(/^\uFEFF/,'');const lines=text.split('\n');if(lines.length<2)return;
  const headers=parseCsvLine(lines[0]).map(h=>h.replace(/\r/,'').trim());
  const ci={};headers.forEach((h,i)=>ci[h]=i);
  const nI=ci['Product_Name'],buI=ci['Cat_BU'],w1I=ci['W1'],w2I=ci['W2'],w3I=ci['W3'],w4I=ci['W4'];
  stockRows=[];
  for(let i=1;i<lines.length;i++){
    const cols=parseCsvLine(lines[i]);const name=(cols[nI]||'').replace(/\r/,'').trim();if(!name)continue;
    const n=j=>j!==undefined?parseFloat(String(cols[j]||'0').replace(/,/g,''))||0:0;
    stockRows.push({name,cat_bu:buI!==undefined?String(cols[buI]||'').trim():'',w1:n(w1I),w2:n(w2I),w3:n(w3I),w4:n(w4I)});
  }
}
async function fetchAll(){await Promise.all([fetchData(),fetchStock(),fetchTarget()]);}

