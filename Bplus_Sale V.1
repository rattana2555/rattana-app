function renderProducts(){
  const rows=filterRows(selectedPeriod,selectedWH);const q=productSearch.toLowerCase();
  const grouped={};
  rows.forEach(r=>{const key=r.product+'|||'+r.cat;
    if(!grouped[key])grouped[key]={name:r.product,cat:r.cat,baht:0,cs:0,txn:0};
    grouped[key].baht+=r.baht;grouped[key].cs+=r.cs;grouped[key].txn++;});
  let items=Object.values(grouped);
  if(q)items=items.filter(i=>i.name.toLowerCase().includes(q)||i.cat.toLowerCase().includes(q));
  items.sort((a,b)=>b.baht-a.baht);
  $('productCountLabel').textContent=items.length.toLocaleString()+' สินค้า';
  $('productList').innerHTML=items.slice(0,200).map(item=>{
    const m=CAT_META[item.cat]||{icon:'📦',color:'#888',bg:'#eee'};
    return `<div class="product-item">
      <div style="width:36px;height:36px;border-radius:10px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;margin-right:10px">${m.icon}</div>
      <div class="product-left"><div class="product-name">${item.name}</div><div class="product-cat" style="color:${m.color}">${item.cat.replace('Bplus ','')}</div></div>
      <div class="product-right"><div class="product-baht num">฿${fmtBaht(item.baht)}</div><div class="product-cs num">${fmtCs(item.cs)} ลัง</div></div>
    </div>`;}).join('')||'<div class="empty">ไม่มีข้อมูล</div>';
}

function getStockVal(row){
  if(stockWH==='all')return row.w1+row.w2+row.w3+row.w4;
  return row[stockWH.toLowerCase()]||0;
}
function renderStock(){
  if(!stockRows.length){$('stockCatList').innerHTML='<div class="empty">⚠️ ยังไม่มีข้อมูลสต็อก</div>';$('stockHeroBig').textContent='—';return;}
  const totalStock=stockRows.reduce((s,r)=>s+getStockVal(r),0);
  $('stockHeroSub').textContent=(stockWH==='all'?'ทุกคลัง':stockWH)+' · ทุกหมวด';
  $('stockHeroBig').textContent=totalStock.toLocaleString('th-TH',{maximumFractionDigits:0});
  $('stockHeroSKU').textContent=stockRows.length.toLocaleString();
  $('stockHeroCat').textContent=new Set(stockRows.map(r=>r.cat_bu).filter(Boolean)).size||TARGET_CATS.length;
  $('totalStockRows').textContent=stockRows.length.toLocaleString()+' รายการ';
  if(!stockActiveCat){
    $('stockProductSection').style.display='none';$('stockCatList').style.display='';
    const catData=TARGET_CATS.map(cat=>{const rows=stockRows.filter(r=>r.cat_bu===cat);
      const total=rows.reduce((s,r)=>s+getStockVal(r),0);
      return{cat,total,hasSKU:rows.filter(r=>getStockVal(r)>0).length,allSKU:rows.length};});
    const maxStock=Math.max(...catData.map(d=>d.total),1);
    $('stockCatList').innerHTML=catData.map(d=>{
      const m=CAT_META[d.cat]||{icon:'📦',color:'#888',bg:'#eee'};
      return `<div class="stock-cat-item" onclick="openStockCat('${d.cat}')">
        <div class="stock-cat-icon" style="background:${m.bg}">${m.icon}</div>
        <div class="stock-cat-body">
          <div class="stock-cat-name">${d.cat}</div>
          <div class="stock-cat-sku">${d.hasSKU.toLocaleString()} / ${d.allSKU.toLocaleString()} SKU มีสต็อก</div>
          <div class="stock-progress-track"><div class="stock-progress-bar" style="width:${Math.round(d.total/maxStock*100)}%;background:${m.color}"></div></div>
        </div>
        <div class="stock-cat-right">
          <div class="stock-cat-val num">${d.total>=1000?(d.total/1000).toFixed(1)+'K':d.total.toLocaleString()}</div>
          <div class="stock-cat-arrow">ลัง ›</div>
        </div>
      </div>`;}).join('');
  }else{$('stockProductSection').style.display='';$('stockCatList').style.display='none';renderStockProducts();}
}
function openStockCat(cat){
  stockActiveCat=cat;stockSearch='';stockFilter='all';$('stockSearch').value='';
  document.querySelectorAll('.stock-filter-chip').forEach(c=>{c.classList.remove('active','active-out');if(c.dataset.sf==='all')c.classList.add('active');});
  $('stockProductTitle').textContent=(CAT_META[cat]?.icon||'📦')+' '+cat;renderStock();
}
function renderStockProducts(){
  const q=stockSearch.toLowerCase();
  let rows=stockRows.filter(r=>r.cat_bu===stockActiveCat);
  if(q)rows=rows.filter(r=>r.name.toLowerCase().includes(q));
  if(stockFilter==='in')rows=rows.filter(r=>getStockVal(r)>0);
  if(stockFilter==='out')rows=rows.filter(r=>getStockVal(r)===0);
  rows=rows.slice().sort((a,b)=>getStockVal(b)-getStockVal(a));
  if(!rows.length){$('stockProductList').innerHTML='<div class="empty">ไม่พบสินค้า</div>';return;}
  const maxVal=Math.max(...rows.map(r=>Math.max(r.w1,r.w2,r.w3,r.w4)),1);
  const isFilt=stockWH!=='all';
  $('stockProductList').innerHTML=rows.slice(0,200).map(r=>{
    const displayTotal=isFilt?getStockVal(r):r.w1+r.w2+r.w3+r.w4;
    const whCells=[{key:'W1',val:r.w1},{key:'W2',val:r.w2},{key:'W3',val:r.w3},{key:'W4',val:r.w4}].map(({key,val})=>{
      const meta=WH_META[key];const pct=Math.round(val/maxVal*100);
      const dim=isFilt&&stockWH!==key?'opacity:.35;':'';
      return `<div class="stock-wh-cell${val===0?' zero':''}" style="${dim}">
        <span class="stock-wh-label ${meta.lc}">${key}</span>
        <div class="stock-wh-num num">${val.toLocaleString()}</div><div class="stock-wh-unit">ลัง</div>
        <div class="stock-wh-bar-track"><div class="stock-wh-bar-fill ${meta.bc}" style="height:${pct}%"></div></div>
      </div>`;}).join('');
    return `<div class="stock-prod-card">
      <div class="stock-prod-header">
        <div class="stock-prod-name">${r.name}</div>
        <div class="stock-prod-total-badge"><div class="stock-prod-total-num num">${displayTotal.toLocaleString()}</div><div class="stock-prod-total-label">${isFilt?stockWH:'รวม'} · ลัง</div></div>
      </div>
      <div class="stock-wh-grid">${whCells}</div>
    </div>`;}).join('');
}

function renderProfile(){
  $('dataSource').textContent=dataSourceLabel;$('stockSource').textContent=stockSourceLabel;
  $('targetSource').textContent=targetSourceLabel;$('lastUpdated').textContent=lastUpdated||'—';
  $('totalRows').textContent=allRows.length.toLocaleString()+' รายการ';
  $('totalStockRows').textContent=stockRows.length.toLocaleString()+' รายการ';
}

