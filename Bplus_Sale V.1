  document.querySelectorAll('.period-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');selectedPeriod=btn.dataset.period;
  const titles={today:'ยอดขายวันนี้',yesterday:'ยอดขายเมื่อวาน',week:'ยอดขาย 7 วัน',month:'ยอดขายเดือนนี้',year:'ยอดขายปีนี้'};
  $('homeTitle').textContent=titles[selectedPeriod]||'ยอดขาย';renderHome();});});
$('productSearch').addEventListener('input',e=>{productSearch=e.target.value;renderProducts();});
document.querySelectorAll('[data-swh]').forEach(chip=>{chip.addEventListener('click',()=>{
  document.querySelectorAll('[data-swh]').forEach(c=>c.classList.remove('active'));
  chip.classList.add('active');stockWH=chip.dataset.swh;stockActiveCat=null;renderStock();});});
$('stockSearch').addEventListener('input',e=>{stockSearch=e.target.value;renderStockProducts();});
$('stockBackBtn').addEventListener('click',()=>{stockActiveCat=null;stockSearch='';stockFilter='all';renderStock();});
document.querySelectorAll('.stock-filter-chip').forEach(chip=>{chip.addEventListener('click',()=>{
  stockFilter=chip.dataset.sf;document.querySelectorAll('.stock-filter-chip').forEach(c=>c.classList.remove('active','active-out'));
  chip.classList.add(stockFilter==='out'?'active-out':'active');renderStockProducts();});});
$('refreshBtn').addEventListener('click',()=>fetchAll());
$('stockRefreshBtn').addEventListener('click',()=>fetchStock());
function handleCSV(input){
  const file=input.files[0];if(!file)return;$('uploadOverlay').classList.remove('show');
  showSpinner('อ่านไฟล์ SQLBP...');const r=new FileReader();
  r.onload=e=>{parseSQLBP(e.target.result);dataSourceLabel='CSV Upload';hideSpinner();renderAll();toast(`ยอดขาย ${allRows.length.toLocaleString()} รายการ`);};
  r.readAsText(file,'UTF-8');
}
$('csvInput').addEventListener('change',function(){handleCSV(this);});
$('profileCsvInput').addEventListener('change',function(){handleCSV(this);});
$('uploadBtn').addEventListener('click',()=>$('csvInput').click());
$('uploadCancel').addEventListener('click',()=>$('uploadOverlay').classList.remove('show'));
$('profileStockCsvInput').addEventListener('change',function(){handleStockCSV(this);});
$('profileTargetCsvInput').addEventListener('change',function(){handleTargetCSV(this);});
$('seeAllCat').addEventListener('click',()=>{document.querySelector('[data-page="Reports"]').click();});

// ── Boot ─────────────────────────────────────────────────────
fetchData();fetchStock();fetchTarget();
</script>
</body>
</html>
