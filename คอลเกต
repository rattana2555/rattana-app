function resetForm() {
  ['shopName','houseNo','moo','zipCode'].forEach(id => document.getElementById(id).value = '');
  sel = { type:'', provId:null, provName:'', ampId:null, ampName:'', tamId:null, tamName:'', zip:'' };

  resetDD('ddType', 'ddTypeVal', '-- เลือกประเภทร้านค้า --');
  resetDD('ddProv', 'ddProvVal', '-- เลือกจังหวัด --');
  resetDD('ddAmp',  'ddAmpVal',  '-- เลือกอำเภอ/เขต --');
  resetDD('ddTam',  'ddTamVal',  '-- เลือกตำบล/แขวง --');

  document.getElementById('ddAmpBtn').disabled = true;
  document.getElementById('ddTamBtn').disabled = true;
  document.getElementById('ddAmpList').innerHTML = '<li class="muted">กรุณาเลือกจังหวัดก่อน</li>';
  document.getElementById('ddTamList').innerHTML = '<li class="muted">กรุณาเลือกอำเภอก่อน</li>';

  showToast('ล้างข้อมูลแล้ว ✓', 'info');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ══════════════════════════════════════════════
//  CSV PARSER (RFC-4180)
// ══════════════════════════════════════════════
function parseCsv(text) {
  if (!text) return [];
  if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1);
  const rows = []; let row = [], cell = '', inQ = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (inQ) {
      if (c==='"') { if (text[i+1]==='"'){cell+='"';i++;}else inQ=false; }
      else cell += c;
    } else {
      if (c==='"') inQ=true;
      else if (c===','){row.push(cell);cell='';}
      else if (c==='\r'){}
      else if (c==='\n'){row.push(cell);rows.push(row);row=[];cell='';}
      else cell+=c;
    }
  }
  if (cell||row.length){row.push(cell);rows.push(row);}
  if (!rows.length) return [];
  const clean = s => String(s||'').replace(/[\u200B\u200C\u200D\uFEFF]/g,'').replace(/\u00A0/g,' ').trim();
  const hdrs  = rows[0].map(clean);
  return rows.slice(1).filter(r=>r.some(c=>clean(c))).map(r=>Object.fromEntries(hdrs.map((k,i)=>[k,clean(r[i])])));
}

// ══════════════════════════════════════════════
//  UTILS
// ══════════════════════════════════════════════
const showSpinner = m => { document.getElementById('spinnerMsg').textContent = m||'Loading...'; document.getElementById('spinner').classList.add('show'); };
const hideSpinner = () => document.getElementById('spinner').classList.remove('show');
const setBar      = on => document.getElementById('loadingBar').style.width = on ? '85%' : '0';

function showToast(msg, type='info') {
  const t = document.createElement('div');
  t.className = `toast toast-${type}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3800);
}

function esc(s) {
  return String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function toggleDark() {
  document.body.classList.toggle('dark');
  localStorage.setItem('rdark', document.body.classList.contains('dark') ? '1' : '0');
}
function checkDark() {
  if (localStorage.getItem('rdark') === '1') document.body.classList.add('dark');
}
