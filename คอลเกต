<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Rattana Colgate v1.1</title>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --navy:        #0d1b3e;
  --navy-mid:    #1a2f5e;
  --navy-light:  #243b73;
  --gold:        #c9a84c;
  --gold-light:  #e8c86a;
  --success:     #2ecc71;
  --danger:      #e74c3c;
  --warning:     #f39c12;
  --info:        #3498db;
  --bg:          #f4f6fb;
  --text:        #0d1b3e;
  --card-bg:     #ffffff;
  --border:      #dde3f0;
  --muted:       #6b7896;
  --row-alt:     #fafbfd;
  --radius-sm:   6px;
  --radius-md:   12px;
  --radius-lg:   16px;
  --shadow-md:   0 2px 8px rgba(0,0,0,.08);
  --shadow-lg:   0 8px 24px rgba(13,27,62,.12);
  --shadow-gold: 0 4px 12px rgba(201,168,76,.35);
}
body.dark {
  --bg:      #0a1020;
  --text:    #e8eaf0;
  --card-bg: #111c35;
  --border:  #243b73;
  --muted:   #8a98b8;
  --row-alt: #0f1830;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Sarabun',sans-serif;min-height:100dvh;background:var(--bg);color:var(--text);transition:background .25s,color .25s;overflow-x:hidden}
button{font-family:inherit;cursor:pointer;border:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
input,select,textarea{font-family:inherit;font-size:16px}

/* ── Header ── */
header{background:var(--navy);color:#fff;padding:12px 16px;position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:12px;border-bottom:3px solid var(--gold);padding-top:max(12px,env(safe-area-inset-top))}
.logo-text{font-weight:700;letter-spacing:1.5px;font-size:17px;color:#fff;flex:1}
.logo-text span{color:var(--gold)}
.icon-btn{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.2);width:38px;height:38px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:18px;transition:background .15s;flex-shrink:0}
.icon-btn:hover{background:rgba(255,255,255,.12)}
.version-tag{font-size:11px;color:rgba(255,255,255,.38);white-space:nowrap;flex-shrink:0}

/* ── Layout ── */
.page-wrap{max-width:640px;margin:0 auto;padding:16px 12px;padding-bottom:max(32px,env(safe-area-inset-bottom))}
@media(min-width:640px){.page-wrap{padding:24px 20px}}

/* ── Card ── */
.card{background:var(--card-bg);border-radius:var(--radius-md);border:1px solid var(--border);box-shadow:var(--shadow-md);overflow:hidden}
.card-gold{border-top:3px solid var(--gold)}
.card-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--border);background:linear-gradient(to right,rgba(201,168,76,.08),transparent)}
.card-head h2{font-size:16px;font-weight:700}
.card-body{padding:20px}

/* ── Section Divider ── */
.sec-div{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.5px;text-transform:uppercase;margin:20px 0 12px;display:flex;align-items:center;gap:8px}
.sec-div::after{content:'';flex:1;height:1px;background:var(--border)}

/* ── Fields ── */
.field{display:flex;flex-direction:column;gap:5px;margin-bottom:14px}
.field:last-child{margin-bottom:0}
.field label{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.4px;text-transform:uppercase}
.req{color:var(--danger);margin-left:2px}
.input{height:46px;padding:0 14px;border-radius:var(--radius-sm);border:1.5px solid var(--border);background:var(--card-bg);color:var(--text);font-size:16px;font-family:inherit;outline:none;width:100%;transition:border-color .15s,background .15s}
.input:focus{border-color:var(--gold)}
.input[readonly]{background:var(--row-alt);color:var(--muted);cursor:default;border-style:dashed}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:380px){.grid-2{grid-template-columns:1fr}}

/* ── Custom Dropdown ── */
.dd-wrap{position:relative;width:100%}
.dd-btn{width:100%;min-height:46px;padding:0 14px;background:var(--card-bg);border:1.5px solid var(--border);border-radius:var(--radius-sm);color:var(--text);font-family:'Sarabun',sans-serif;font-size:16px;text-align:left;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:8px;transition:border-color .15s;-webkit-tap-highlight-color:transparent}
.dd-btn:focus,.dd-btn.open{border-color:var(--gold);outline:none}
.dd-btn .dd-val{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dd-btn.placeholder .dd-val{color:var(--muted)}
.dd-arrow{font-size:12px;color:var(--muted);flex-shrink:0;transition:transform .2s}
.dd-btn.open .dd-arrow{transform:rotate(180deg)}
.dd-btn:disabled{opacity:.5;cursor:not-allowed}

.dd-panel{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--card-bg);border:1.5px solid var(--gold);border-radius:var(--radius-sm);z-index:600;box-shadow:0 8px 32px rgba(0,0,0,.18);display:none;flex-direction:column;max-height:280px}
.dd-panel.open{display:flex}
.dd-search{padding:10px 14px;font-size:16px;border:none;border-bottom:1px solid var(--border);background:transparent;color:var(--text);outline:none;font-family:'Sarabun',sans-serif;border-radius:var(--radius-sm) var(--radius-sm) 0 0;flex-shrink:0}
.dd-list{overflow-y:auto;flex:1;list-style:none;padding:4px 0;margin:0;-webkit-overflow-scrolling:touch}
.dd-list li{padding:11px 14px;cursor:pointer;font-size:15px;border-bottom:1px solid transparent}
.dd-list li:hover,.dd-list li:active{background:var(--navy-light);color:#fff}
.dd-list li.muted{color:var(--muted);cursor:default;font-style:italic;font-size:13px}

/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:10px 18px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;font-family:inherit;cursor:pointer;border:1.5px solid transparent;min-height:44px;transition:opacity .15s,transform .1s;-webkit-tap-highlight-color:transparent}
.btn:hover{opacity:.88}
.btn:active{transform:scale(.97)}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none}
.btn-gold{background:var(--gold);color:var(--navy);border-color:var(--gold);font-weight:700}
.btn-gold:hover{background:var(--gold-light)}
.btn-outline{background:transparent;color:var(--text);border-color:var(--border)}
.btn-lg{padding:14px 20px;font-size:15px;min-height:52px;border-radius:var(--radius-md)}
.btn-block{width:100%}

/* ── Toast ── */
.toast{position:fixed;bottom:max(24px,env(safe-area-inset-bottom));right:16px;padding:12px 18px;border-radius:var(--radius-md);color:#fff;z-index:9999;animation:slideIn .3s ease;font-weight:500;box-shadow:var(--shadow-lg);max-width:calc(100vw - 32px);font-size:13px;pointer-events:none}
.toast-success{background:var(--success)}
.toast-error{background:var(--danger)}
.toast-warning{background:var(--warning);color:var(--navy)}
.toast-info{background:var(--navy-mid);border-left:3px solid var(--gold)}

/* ── Spinner ── */
#spinner{display:none;position:fixed;inset:0;background:rgba(13,27,62,.6);align-items:center;justify-content:center;z-index:99999;backdrop-filter:blur(4px)}
#spinner.show{display:flex}
.spin-box{background:var(--card-bg);border-radius:var(--radius-lg);padding:32px 44px;text-align:center;border-top:4px solid var(--gold);min-width:220px}
.spin-ring{width:48px;height:48px;border:5px solid var(--border);border-top-color:var(--gold);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 14px}
.spin-msg{font-size:14px;color:var(--muted)}

#loadingBar{position:fixed;top:0;left:0;height:3px;background:var(--gold);width:0;transition:width .4s ease;z-index:10000}

/* ── Success screen ── */
.success-wrap{display:none;text-align:center;padding:40px 24px;animation:fadeIn .35s ease}
.success-wrap.show{display:block}
.success-icon{font-size:72px;margin-bottom:16px;line-height:1}
.success-wrap h2{font-size:22px;font-weight:700;margin-bottom:8px}
.success-wrap p{color:var(--muted);font-size:14px;margin-bottom:28px;line-height:1.6}

/* ── Animations ── */
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes slideIn{from{transform:translateX(calc(100% + 16px));opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* ── Footer ── */
.app-footer{text-align:center;color:var(--muted);font-size:11px;margin-top:20px;padding-top:8px}
</style>
</head>
<body>

<div id="loadingBar"></div>

<div id="spinner">
  <div class="spin-box">
    <div class="spin-ring"></div>
    <p class="spin-msg" id="spinnerMsg">กำลังโหลด...</p>
  </div>
</div>

<header>
  <!-- Rattanaphaiboon Logo -->
  <svg width="36" height="36" viewBox="0 0 36 36" style="flex-shrink:0" aria-hidden="true">
    <circle cx="18" cy="18" r="17" fill="#c9a84c"/>
    <circle cx="18" cy="18" r="13.5" fill="none" stroke="#fff" stroke-width="1.2"/>
    <circle cx="18" cy="18" r="10" fill="#0d1b3e"/>
    <text x="18" y="16" text-anchor="middle" font-size="5.5" fill="#c9a84c" font-weight="700" font-family="Sarabun,sans-serif">รัตน</text>
    <text x="18" y="23" text-anchor="middle" font-size="4.5" fill="#c9a84c" font-weight="600" font-family="Sarabun,sans-serif">ภัยพิบูลย์</text>
  </svg>
  <div class="logo-text">RATTANA <span>COLGATE</span></div>
  <span class="version-tag">v1.1</span>
  <button class="icon-btn" onclick="toggleDark()" title="โหมดกลางคืน" aria-label="Toggle dark mode">🌙</button>
</header>

<div class="page-wrap">

  <!-- ══ FORM CARD ══ -->
  <div class="card card-gold" id="formCard">
    <div class="card-head">
      <span style="font-size:22px">🏪</span>
      <h2>ลงทะเบียนข้อมูลร้านค้า</h2>
    </div>
    <div class="card-body">

      <!-- 1. ชื่อร้านค้า -->
      <div class="field">
        <label>ชื่อร้านค้า<span class="req">*</span></label>
        <input class="input" id="shopName" type="text" placeholder="กรอกชื่อร้านค้า" autocomplete="off" autocorrect="off">
      </div>

      <!-- 2. ประเภทร้านค้า -->
      <div class="field">
        <label>ประเภทร้านค้า<span class="req">*</span></label>
        <div class="dd-wrap" id="ddType">
          <button class="dd-btn placeholder" id="ddTypeBtn" onclick="toggleDD('ddType')" type="button" aria-haspopup="listbox">
            <span class="dd-val" id="ddTypeVal">-- เลือกประเภทร้านค้า --</span>
            <span class="dd-arrow">▼</span>
          </button>
          <div class="dd-panel" id="ddTypePanel" role="listbox">
            <input class="dd-search" type="text" placeholder="🔍 ค้นหาประเภท..." oninput="filterDD(this,'ddTypeList')" autocomplete="off">
            <ul class="dd-list" id="ddTypeList">
              <li class="muted">⏳ กำลังโหลด...</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 3. ที่อยู่ -->
      <div class="sec-div">ที่อยู่</div>

      <div class="grid-2">
        <div class="field">
          <label>บ้านเลขที่<span class="req">*</span></label>
          <input class="input" id="houseNo" type="text" placeholder="เช่น 123/4" autocomplete="off">
        </div>
        <div class="field">
          <label>หมู่ที่</label>
          <input class="input" id="moo" type="text" placeholder="เช่น 5 (ถ้ามี)" autocomplete="off">
        </div>
      </div>

      <!-- 4a. จังหวัด -->
      <div class="field">
        <label>จังหวัด<span class="req">*</span></label>
        <div class="dd-wrap" id="ddProv">
          <button class="dd-btn placeholder" id="ddProvBtn" onclick="toggleDD('ddProv')" type="button" aria-haspopup="listbox">
            <span class="dd-val" id="ddProvVal">-- เลือกจังหวัด --</span>
            <span class="dd-arrow">▼</span>
          </button>
          <div class="dd-panel" id="ddProvPanel" role="listbox">
            <ul class="dd-list" id="ddProvList">
              <li class="muted">⏳ กำลังโหลด...</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 4b. อำเภอ -->
      <div class="field">
        <label>อำเภอ / เขต<span class="req">*</span></label>
        <div class="dd-wrap" id="ddAmp">
          <button class="dd-btn placeholder" id="ddAmpBtn" onclick="toggleDD('ddAmp')" type="button" aria-haspopup="listbox" disabled>
            <span class="dd-val" id="ddAmpVal">-- เลือกอำเภอ/เขต --</span>
            <span class="dd-arrow">▼</span>
          </button>
          <div class="dd-panel" id="ddAmpPanel" role="listbox">
            <ul class="dd-list" id="ddAmpList">
              <li class="muted">กรุณาเลือกจังหวัดก่อน</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 4c. ตำบล -->
      <div class="field">
        <label>ตำบล / แขวง<span class="req">*</span></label>
        <div class="dd-wrap" id="ddTam">
          <button class="dd-btn placeholder" id="ddTamBtn" onclick="toggleDD('ddTam')" type="button" aria-haspopup="listbox" disabled>
            <span class="dd-val" id="ddTamVal">-- เลือกตำบล/แขวง --</span>
            <span class="dd-arrow">▼</span>
          </button>
          <div class="dd-panel" id="ddTamPanel" role="listbox">
            <ul class="dd-list" id="ddTamList">
              <li class="muted">กรุณาเลือกอำเภอก่อน</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 5. รหัสไปรษณีย์ (auto) -->
      <div class="field">
        <label>รหัสไปรษณีย์</label>
        <input class="input" id="zipCode" type="text" placeholder="กรอกอัตโนมัติจากตำบล" readonly aria-label="รหัสไปรษณีย์อัตโนมัติ">
      </div>

      <!-- Action buttons -->
      <div style="display:flex;gap:10px;margin-top:24px">
        <button class="btn btn-outline" type="button" onclick="resetForm()" style="min-width:90px">
          ↺ ล้าง
        </button>
        <button class="btn btn-gold btn-lg btn-block" type="button" onclick="submitForm()" id="btnSubmit">
          💾 บันทึกข้อมูลร้านค้า
        </button>
      </div>

    </div>
  </div>

  <!-- ══ SUCCESS ══ -->
  <div class="success-wrap card card-gold" id="successCard">
    <div class="card-body">
      <div class="success-icon">✅</div>
      <h2>บันทึกสำเร็จ!</h2>
      <p id="successDetail">ข้อมูลร้านค้าถูกบันทึกเรียบร้อยแล้ว</p>
      <button class="btn btn-gold btn-lg btn-block" onclick="newEntry()">
        ➕ เพิ่มร้านค้าใหม่
      </button>
    </div>
  </div>

  <div class="app-footer">Rattana Colgate v1.1 · 26 พ.ค. 2568</div>

</div><!-- /page-wrap -->

<script>
// ══════════════════════════════════════════════
//  CONFIG — แก้ค่าตรงนี้ก่อนใช้งานจริง
// ══════════════════════════════════════════════
const CFG = {
  sheetId:   '19XHdS_Ft7NpQVkFEd2InNjH1CD6y6w6Vgd38Zyx8j0w',
  sheetName: 'Data Center',

  // คอลัมน์ใน Sheet
  colShopType: 'ประเภทร้านค้า',
  colTambon:   'ตำบล',
  colAmphure:  'อำเภอ',
  colProvince: 'จังหวัด',
  colZip:      'ส่วนกลาง/รหัสไปรษณีย์',

  // ── Google Apps Script Web App URL (doPost) สำหรับบันทึก ──
  gasUrl: 'https://script.google.com/macros/s/AKfycbxARH-w4FkBL7HD90FWimc9CZe2P4Nw5IuVRJSGHScNZ1L3Bh2jJ34gKLMBe-_0wa5pqQ/exec',
};

// ══════════════════════════════════════════════
//  STATE
// ══════════════════════════════════════════════
let sel = { type: '', provId: null, provName: '', ampId: null, ampName: '', tamId: null, tamName: '', zip: '' };
let DB  = { rows: [] };

// ══════════════════════════════════════════════
//  INIT
// ══════════════════════════════════════════════
window.onload = () => {
  checkDark();
  showSpinner('กำลังโหลดข้อมูล...');
  setBar(true);
  loadSheet()
    .catch(() => {
      buildTypeList(['โชห่วย','มินิมาร์ท','ร้านยา','ร้านสะดวกซื้อ','อื่นๆ']);
      showToast('⚠️ โหลดข้อมูลไม่สำเร็จ กรุณาตรวจสอบ Sheet', 'error');
    })
    .finally(() => { hideSpinner(); setBar(false); });
};

// ══════════════════════════════════════════════
//  LOAD FROM SHEET (Shop Types + Address)
// ══════════════════════════════════════════════
async function loadShopTypes() {
  // จะถูกดึงพร้อม loadAddress() ใน loadSheet()
}

async function loadAddress() {
  // จะถูกดึงพร้อมกันใน loadSheet()
}

async function loadSheet() {
  const res = await fetch(`${CFG.gasUrl}?t=${Date.now()}`);
  if (!res.ok) throw new Error('fetch failed');
  const json = await res.json();
  if (json.error) throw new Error(json.error);

  // ── ประเภทร้านค้า ──
  buildTypeList(json.shopTypes.length ? json.shopTypes : ['โชห่วย','มินิมาร์ท','ร้านยา','ร้านสะดวกซื้อ','อื่นๆ']);

  // ── ที่อยู่ ──
  DB.rows = json.address;

  const provSet = [...new Set(DB.rows.map(r => r.province))].sort((a,b)=>a.localeCompare(b,'th'));
  document.getElementById('ddProvList').innerHTML =
    provSet.map(p => `<li role="option" onclick="pickProv('${esc(p)}')">${esc(p)}</li>`).join('');
}

function buildTypeList(list) {
  document.getElementById('ddTypeList').innerHTML =
    list.map(t => `<li role="option" onclick="pickType('${esc(t)}')">${esc(t)}</li>`).join('');
}

function pickType(val) {
  sel.type = val;
  setDD('ddType', 'ddTypeVal', 'ddTypePanel', val);
}

function pickProv(name) {
  sel.provId = name; sel.provName = name;
  sel.ampId = null; sel.ampName = '';
  sel.tamId = null; sel.tamName = ''; sel.zip = '';
  setDD('ddProv','ddProvVal','ddProvPanel', name);

  resetDD('ddAmp','ddAmpVal','-- เลือกอำเภอ/เขต --');
  resetDD('ddTam','ddTamVal','-- เลือกตำบล/แขวง --');
  document.getElementById('zipCode').value = '';
  document.getElementById('ddAmpBtn').disabled = false;
  document.getElementById('ddTamBtn').disabled = true;

  const amps = [...new Set(
    DB.rows.filter(r => r.province === name).map(r => r.amphure)
  )].sort((a,b)=>a.localeCompare(b,'th'));

  document.getElementById('ddAmpList').innerHTML =
    amps.map(a => `<li role="option" onclick="pickAmp('${esc(a)}')">${esc(a)}</li>`).join('')
    || '<li class="muted">ไม่พบข้อมูล</li>';
  document.getElementById('ddTamList').innerHTML = '<li class="muted">กรุณาเลือกอำเภอก่อน</li>';
}

function pickAmp(name) {
  sel.ampId = name; sel.ampName = name;
  sel.tamId = null; sel.tamName = ''; sel.zip = '';
  setDD('ddAmp','ddAmpVal','ddAmpPanel', name);

  resetDD('ddTam','ddTamVal','-- เลือกตำบล/แขวง --');
  document.getElementById('zipCode').value = '';
  document.getElementById('ddTamBtn').disabled = false;

  const tams = DB.rows
    .filter(r => r.province === sel.provName && r.amphure === name)
    .sort((a,b)=>a.tambon.localeCompare(b.tambon,'th'));

  document.getElementById('ddTamList').innerHTML =
    tams.map(t => `<li role="option" onclick="pickTam('${esc(t.tambon)}','${esc(t.zip || '')}')">${esc(t.tambon)}</li>`).join('')
    || '<li class="muted">ไม่พบข้อมูล</li>';
}

function pickTam(name, zip) {
  sel.tamId = name; sel.tamName = name; sel.zip = zip || '';
  setDD('ddTam','ddTamVal','ddTamPanel', name);
  document.getElementById('zipCode').value = zip || '';
}

// ══════════════════════════════════════════════
//  DROPDOWN HELPERS
// ══════════════════════════════════════════════
function setDD(wrapId, valId, panelId, value) {
  const btn = document.getElementById(wrapId).querySelector('.dd-btn');
  document.getElementById(valId).textContent = value;
  btn.classList.remove('placeholder','open');
  document.getElementById(panelId).classList.remove('open');
}

function resetDD(wrapId, valId, placeholder) {
  const btn = document.getElementById(wrapId).querySelector('.dd-btn');
  document.getElementById(valId).textContent = placeholder;
  btn.classList.add('placeholder');
  btn.classList.remove('open');
}

function toggleDD(wrapId) {
  const wrap  = document.getElementById(wrapId);
  const btn   = wrap.querySelector('.dd-btn');
  const panel = wrap.querySelector('.dd-panel');
  if (btn.disabled) return;

  const isOpen = panel.classList.contains('open');
  // Close all
  document.querySelectorAll('.dd-panel.open').forEach(p => p.classList.remove('open'));
  document.querySelectorAll('.dd-btn.open').forEach(b => b.classList.remove('open'));

  if (!isOpen) {
    panel.classList.add('open');
    btn.classList.add('open');
    const s = panel.querySelector('.dd-search');
    if (s) {
      s.value = '';
      s.focus();
      // Reset filter
      panel.querySelectorAll('.dd-list li').forEach(li => li.style.display = '');
    }
  }
}

function filterDD(inp, listId) {
  const q = inp.value.toLowerCase().trim();
  document.querySelectorAll(`#${listId} li`).forEach(li => {
    if (li.classList.contains('muted')) { li.style.display = q ? 'none' : ''; return; }
    li.style.display = li.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
}

// Close on outside click
document.addEventListener('click', e => {
  if (!e.target.closest('.dd-wrap')) {
    document.querySelectorAll('.dd-panel.open').forEach(p => p.classList.remove('open'));
    document.querySelectorAll('.dd-btn.open').forEach(b => b.classList.remove('open'));
  }
});

// ══════════════════════════════════════════════
//  SUBMIT
// ══════════════════════════════════════════════
async function submitForm() {
  const shopName = document.getElementById('shopName').value.trim();
  const houseNo  = document.getElementById('houseNo').value.trim();
  const moo      = document.getElementById('moo').value.trim();
  const zip      = document.getElementById('zipCode').value.trim();

  // Validate required
  const missing = [];
  if (!shopName)      missing.push('ชื่อร้านค้า');
  if (!sel.type)      missing.push('ประเภทร้านค้า');
  if (!houseNo)       missing.push('บ้านเลขที่');
  if (!sel.provId)    missing.push('จังหวัด');
  if (!sel.ampId)     missing.push('อำเภอ/เขต');
  if (!sel.tamId)     missing.push('ตำบล/แขวง');

  if (missing.length) {
    showToast('⚠️ กรุณากรอก: ' + missing.join(', '), 'error');
    return;
  }

  const payload = {
    timestamp: new Date().toLocaleString('th-TH', { dateStyle:'short', timeStyle:'short' }),
    shopName,
    shopType:  sel.type,
    houseNo,
    moo:       moo || '',
    tambon:    sel.tamName,
    amphure:   sel.ampName,
    province:  sel.provName,
    zipCode:   zip,
    tamAmpProv:  `${sel.tamName},${sel.ampName},${sel.provName}`,
    fullAddress: `${houseNo}${moo ? ' หมู่ '+moo : ''} ต.${sel.tamName} อ.${sel.ampName} จ.${sel.provName} ${zip}`,
  };

  const btn = document.getElementById('btnSubmit');
  btn.disabled = true;
  showSpinner('กำลังบันทึก...');
  setBar(true);

  try {
    if (CFG.gasUrl === 'YOUR_GAS_WEB_APP_URL') throw new Error('demo');
    const res = await fetch(CFG.gasUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('server');
    showSuccessScreen(shopName);
  } catch(err) {
    if (CFG.gasUrl === 'YOUR_GAS_WEB_APP_URL') {
      // Demo mode — still show success UI
      showSuccessScreen(shopName);
      showToast('⚠️ Demo Mode — ข้อมูลยังไม่ถูกบันทึกจริง', 'warning');
    } else {
      showToast('❌ บันทึกไม่สำเร็จ กรุณาลองใหม่', 'error');
    }
  } finally {
    btn.disabled = false;
    hideSpinner();
    setBar(false);
  }
}

function showSuccessScreen(name) {
  document.getElementById('formCard').style.display  = 'none';
  document.getElementById('successCard').style.display = '';
  document.getElementById('successCard').classList.add('show');
  document.getElementById('successDetail').innerHTML =
    `ร้าน <strong>"${esc(name)}"</strong><br>ถูกบันทึกลง Google Sheet เรียบร้อยแล้ว`;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function newEntry() {
  document.getElementById('successCard').style.display = 'none';
  document.getElementById('successCard').classList.remove('show');
  document.getElementById('formCard').style.display = '';
  resetForm();
}

// ══════════════════════════════════════════════
