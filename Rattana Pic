/* ============== ESCAPING ============== */
function escapeHtml(s) {
  return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escapeAttr(s) { return escapeHtml(s).replace(/`/g, '&#96;'); }
function cssId(s) { return String(s||'').replace(/[^a-zA-Z0-9_-]/g,'_'); }

