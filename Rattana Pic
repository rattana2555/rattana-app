        </div>
        <div class="tag-tpl-pick">
          <button class="tpl-btn ${t==='regular'?'active':''}" onclick="setTpl('${sku}','regular')">ปกติ</button>
          <button class="tpl-btn ${t==='sale'?'active':''}"    onclick="setTpl('${sku}','sale')">ลดราคา</button>
          <button class="tpl-btn ${t==='new'?'active':''}"     onclick="setTpl('${sku}','new')">ใหม่</button>
          <button class="tpl-btn ${t==='bogo'?'active':''}"    onclick="setTpl('${sku}','bogo')">1+1</button>
        </div>
        <div class="txt-center txt-muted" style="font-size:11px;margin-top:6px">${escapeHtml(p.name)}</div>
      </div>`;
  }).join('');
  // Inject QR + Barcode
  sel.forEach(p => {
    const r = { qrId: `qr-design-${cssId(p.sku)}`, bcId: `bc-design-${cssId(p.sku)}` };
    attachCodes(p, r.qrId, r.bcId);
  });
}
function setTpl(sku, tpl) {
  tplOverrides[sku] = tpl;
  renderDesignStage();
}
function bulkSetTemplate(tpl) {
  const sel = products.filter(p => selectedSkus.has(p.sku));
  sel.forEach(p => tplOverrides[p.sku] = tpl);
  renderDesignStage();
  showToast(`ตั้ง Template เป็น "${tpl}" ${sel.length} รายการ`, 'success');
}

/* ============== PDF PREVIEW ============== */
function buildPdfPreview() {
  const stage = $('#pdfStage');
  const sel = products.filter(p => selectedSkus.has(p.sku));
  if (!sel.length) {
    stage.innerHTML = `<div class="empty-state"><div class="emoji">📄</div><h3>ยังไม่มีสินค้าที่เลือก</h3><div>กลับไปแท็บ "เลือกสินค้า" เพื่อเลือกสินค้าก่อน</div></div>`;
    return;
  }
  // 4 tags per A4 page
  const pages = [];
  for (let i = 0; i < sel.length; i += 4) pages.push(sel.slice(i, i+4));
  // Compute scaled wrapper height so layout doesn't get extra blank space below scaled pages
  const w = window.innerWidth;
  const scale = w <= 880 ? 0.42 : (w <= 1100 ? 0.65 : 0.85);
  const innerHTML = pages.map((page, pi) => `
    <div class="pdf-page" id="pdf-page-${pi}">
      ${page.map(p => renderTag(p, 'pdf-p'+pi).html).join('')}
    </div>
  `).join('');
  // px equivalents (A4 portrait): ≈ 794 × 1123 px @ 96dpi
  const pageH = 1123 * scale + 14; // include gap
  const totalH = pageH * pages.length;
  stage.innerHTML = `
    <div class="pdf-wrap" style="width:100%">
      <div class="pdf-wrap-inner" style="height:${totalH}px">
        ${innerHTML}
      </div>
    </div>`;
  // Inject codes
  sel.forEach((p, idx) => {
    const pi = Math.floor(idx / 4);
    const qrId = `qr-pdf-p${pi}-${cssId(p.sku)}`;
    const bcId = `bc-pdf-p${pi}-${cssId(p.sku)}`;
    attachCodes(p, qrId, bcId);
  });
}

/* ============== EXPORT PDF ============== */
async function exportPDF() {
  const sel = products.filter(p => selectedSkus.has(p.sku));
  if (!sel.length) { showToast('ยังไม่ได้เลือกสินค้า', 'warning'); return; }
  showSpinner('กำลังสร้าง PDF... (อาจใช้เวลาสักครู่)');

  // Make sure preview is rendered
  buildPdfPreview();
  await new Promise(r => setTimeout(r, 800)); // wait for images

  // Reset preview scaling during capture so html2canvas reads native A4 size
  const wrapInner = document.querySelector('.pdf-wrap-inner');
  const prevTransform = wrapInner ? wrapInner.style.transform : '';
  const prevHeight    = wrapInner ? wrapInner.style.height : '';
  if (wrapInner) { wrapInner.style.transform = 'none'; wrapInner.style.height = 'auto'; }

  try {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const pages = document.querySelectorAll('.pdf-page');
    for (let i = 0; i < pages.length; i++) {
      $('#spinnerMsg').textContent = `กำลังสร้างหน้า ${i+1}/${pages.length}...`;
      const canvas = await html2canvas(pages[i], {
        scale: 2,
        useCORS: true,
        allowTaint: false,
        backgroundColor: '#ffffff',
        logging: false
      });
      const imgData = canvas.toDataURL('image/jpeg', 0.92);
      if (i > 0) pdf.addPage();
      pdf.addImage(imgData, 'JPEG', 0, 0, 210, 297);
    }
    const filename = `Rattana-PriceTag-${new Date().toISOString().slice(0,10)}.pdf`;
    pdf.save(filename);
    showToast(`✅ บันทึก PDF แล้ว (${pages.length} หน้า, ${sel.length} ป้าย)`, 'success');
  } catch (e) {
    console.error(e);
    showToast('สร้าง PDF ไม่สำเร็จ: '+(e.message||''), 'error');
  } finally {
    // Restore preview scaling
    if (wrapInner) { wrapInner.style.transform = prevTransform; wrapInner.style.height = prevHeight; }
    hideSpinner();
  }
}

