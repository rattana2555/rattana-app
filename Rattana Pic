<script>
/* ============== CONFIG ============== */
const AUTH_CONFIG = {
  clientId: '615875645128-gasjjvkt6lu8g449cbnhl40k1pu25r0b.apps.googleusercontent.com',
  usersSheetId: '1M6HdISsLN684qRWyQ73CA4AmUzmYtZaOlffDJXZZIXQ',
  usersSheetName: 'Rattana Users for apps',
};
const STORAGE = { user: 'rattanaUser_priceTag', config: 'rattanaPriceTag_cfg', cache: 'rattanaPriceTag_cache' };

let currentUser = null;
let products = [];          // loaded raw products
let selectedSkus = new Set();
let tplOverrides = {};      // sku -> 'regular'|'sale'|'new'|'bogo'

/* ============== UTILS ============== */
const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);
const showSpinner = m => { $('#spinnerMsg').textContent = m || 'กำลังโหลด...'; $('#spinner').classList.add('show'); };
const hideSpinner = () => $('#spinner').classList.remove('show');
function showToast(msg, type='info') {
  const t = document.createElement('div');
  t.className = `toast toast-${type}`; t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(), 3500);
}
const normalizeEmail = s => String(s||'').replace(/[​‌‍﻿]/g,'').replace(/\s+/g,'').toLowerCase();
const fmtThaiBaht = n => {
  const v = Number(n);
  if (isNaN(v)) return '-';
  return v.toLocaleString('th-TH', {minimumFractionDigits: v % 1 === 0 ? 0 : 2, maximumFractionDigits: 2});
};
function formatThaiDate(input) {
  if (!input) return '-';
  const d = input instanceof Date ? input : new Date(input);
  if (isNaN(d)) return '-';
  const dd = String(d.getDate()).padStart(2,'0');
  const mm = String(d.getMonth()+1).padStart(2,'0');
  const yyyy = d.getFullYear()+543;
  const hh = String(d.getHours()).padStart(2,'0');
  const mi = String(d.getMinutes()).padStart(2,'0');
  return `${dd}/${mm}/${yyyy} ${hh}.${mi}`;
}
function decodeJwtPayload(token) {
  const parts = String(token||'').split('.');
  if (parts.length < 2) throw new Error('JWT format invalid');
  let b64 = parts[1].replace(/-/g,'+').replace(/_/g,'/');
  const pad = (4 - b64.length % 4) % 4;
  if (pad) b64 += '='.repeat(pad);
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  return JSON.parse(new TextDecoder('utf-8').decode(bytes));
}

/* ============== CSV ============== */
function parseCsv(text) {
  if (!text) return [];
  if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1);
  const rows = []; let row = [], cell = '', inQuote = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (inQuote) {
      if (ch === '"') { if (text[i+1]==='"'){cell+='"';i++;} else inQuote=false; }
      else cell += ch;
    } else {
      if (ch === '"') inQuote = true;
      else if (ch === ',') { row.push(cell); cell=''; }
      else if (ch === '\r') {}
      else if (ch === '\n') { row.push(cell); rows.push(row); row=[]; cell=''; }
      else cell += ch;
    }
  }
  if (cell.length || row.length) { row.push(cell); rows.push(row); }
  if (!rows.length) return [];
  const clean = s => String(s||'').replace(/[​‌‍﻿]/g,'').replace(/ /g,' ').trim();
  const headers = rows[0].map(clean);
  return rows.slice(1).filter(r=>r.some(c=>clean(c))).map(r=>Object.fromEntries(headers.map((k,i)=>[k,clean(r[i])])));
}
async function loadFromSheets(sheetId, sheetName) {
  const url = `https://docs.google.com/spreadsheets/d/${sheetId}/gviz/tq?tqx=out:csv&sheet=${encodeURIComponent(sheetName)}`;
  const res = await fetch(url);
  if (!res.ok) throw new Error('โหลดข้อมูลไม่สำเร็จ (HTTP '+res.status+')');
  const text = await res.text();
  if (text.includes('<html') || text.includes('<!DOCTYPE')) {
    throw new Error('ไม่สามารถเข้าถึง Sheet ได้ — ตรวจสอบว่า "เผยแพร่ในเว็บ" แล้วหรือยัง');
  }
  return parseCsv(text);
}

