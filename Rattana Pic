    }
    currentUser = {
      email,
      name: user['ชื่อ - สกุล']||'',
      nickname: user['ชื่อเล่น']||'',
      role: parseInt(user['User Role'])||1,
      dept: user['แผนก']||'',
      company: user['บริษัท']||'',
      warehouse: user['W']||'',
      empId: user['รหัสพนักงาน']||'',
    };
