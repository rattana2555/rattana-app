        ${pct > 0 ? `<div class="t-discount-badge"><div class="pct">-${pct}%</div><div class="off">OFF</div></div>` : ''}
        <div class="t-img">${imgHtml}</div>
        <div class="t-name">${escapeHtml(p.name)}</div>
        ${p.size ? `<div class="t-size">${escapeHtml(p.size)}</div>` : ''}
        ${p.oldPrice > p.price ? `<div class="t-old">ปกติ ฿${fmtThaiBaht(p.oldPrice)}</div>` : ''}
        <div class="t-price-box">
          <div class="t-price">฿${fmtThaiBaht(p.price)}</div>
          <div class="t-unit">${escapeHtml(p.unit||'บาท')}</div>
        </div>
        ${footer}
      </div>`;
  } else if (type === 'new') {
    html = `
      <div class="tag tpl-new" id="${tagId}">
        <div class="t-head">★ สินค้าใหม่ ★ NEW ★</div>
        <div class="t-new-badge">NEW!</div>
        <div class="t-img">${imgHtml}</div>
        <div class="t-name">${escapeHtml(p.name)}</div>
        ${p.size ? `<div class="t-size">${escapeHtml(p.size)}</div>` : ''}
        <div class="t-price-box">
          <div class="t-price">฿${fmtThaiBaht(p.price)}</div>
          <div class="t-unit">${escapeHtml(p.unit||'บาท')}</div>
        </div>
        ${footer}
      </div>`;
  } else if (type === 'bogo') {
    const promoText = p.promo || 'ซื้อ 1 แถม 1';
    html = `
      <div class="tag tpl-bogo" id="${tagId}">
        <div class="t-head">โปรพิเศษ<span class="sub">SPECIAL PROMO</span></div>
        <div class="t-promo-banner">${escapeHtml(promoText)}</div>
        <div class="t-img">${imgHtml}</div>
        <div class="t-name">${escapeHtml(p.name)}</div>
        ${p.size ? `<div class="t-size">${escapeHtml(p.size)}</div>` : ''}
        <div class="t-price-box">
          <div class="t-price">฿${fmtThaiBaht(p.price)}</div>
          <div class="t-unit">${escapeHtml(p.unit||'บาท')}</div>
        </div>
        ${footer}
      </div>`;
  } else {
    html = `
      <div class="tag tpl-regular" id="${tagId}">
        <div class="t-head">RATTANA MART</div>
        <div class="t-img">${imgHtml}</div>
        <div class="t-name">${escapeHtml(p.name)}</div>
        ${p.size ? `<div class="t-size">${escapeHtml(p.size)}</div>` : ''}
        <div class="t-price-box">
          <div class="t-price">฿${fmtThaiBaht(p.price)}</div>
          <div class="t-unit">${escapeHtml(p.unit||'บาท')}</div>
        </div>
        ${footer}
      </div>`;
  }
  return { html, qrId, bcId };
}
function attachCodes(p, qrId, bcId) {
  // QR code (always — uses sku as content if no specific QR)
  const qrEl = document.getElementById(qrId);
  if (qrEl && p.sku) {
    try {
      const qr = qrcode(0, 'M');
      qr.addData(String(p.sku));
      qr.make();
      qrEl.innerHTML = qr.createSvgTag({ scalable: true, margin: 0 });
      const svg = qrEl.querySelector('svg');
      if (svg) { svg.style.width = '12mm'; svg.style.height = '12mm'; }
    } catch (e) { console.warn('QR err', e); }
  }
  // Barcode
  const bcEl = document.getElementById(bcId);
  if (bcEl && p.barcode) {
    try {
      const svg = document.createElementNS('http://www.w3.org/2000/svg','svg');
      bcEl.innerHTML = '';
      bcEl.appendChild(svg);
      JsBarcode(svg, String(p.barcode), {
        format: /^\d{13}$/.test(p.barcode) ? 'EAN13' : 'CODE128',
        width: 1.2, height: 28, displayValue: false, margin: 0
      });
      svg.style.maxWidth = '24mm'; svg.style.height = '8mm';
    } catch (e) { console.warn('BC err', e); }
  }
}

