/* ============== TAG RENDERING ============== */
function getTplType(p) { return tplOverrides[p.sku] || p.tagType || 'regular'; }

function renderTag(p, idPrefix='tag') {
  const type = getTplType(p);
  const tagId = `${idPrefix}-${cssId(p.sku)}`;
  const qrId  = `qr-${idPrefix}-${cssId(p.sku)}`;
  const bcId  = `bc-${idPrefix}-${cssId(p.sku)}`;

  let html = '';
  const imgHtml = p.image
    ? `<img src="${escapeAttr(p.image)}" onerror="this.style.display='none';this.parentElement.innerHTML='<div class=t-img-empty>📦</div>'" alt="" crossorigin="anonymous">`
    : `<div class="t-img-empty">📦</div>`;

  const footer = `
    <div class="t-foot">
      <div>
        <div style="font-weight:700">${escapeHtml(p.sku||'')}</div>
        ${p.barcode ? `<div style="font-family:'Courier New',monospace;opacity:.7">${escapeHtml(p.barcode)}</div>` : ''}
      </div>
      <div id="${bcId}"></div>
      <div id="${qrId}"></div>
    </div>`;

  if (type === 'sale') {
    const pct = (p.oldPrice > p.price && p.oldPrice > 0)
      ? Math.round((p.oldPrice - p.price) / p.oldPrice * 100) : 0;
    html = `
      <div class="tag tpl-sale" id="${tagId}">
