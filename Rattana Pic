<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Rattana Price Tag v1.2</title>
<meta name="description" content="ระบบสร้างป้ายราคาสินค้าสำหรับร้านค้ารัตน — ดึงข้อมูลจาก Google Sheet พิมพ์ PDF A4 4 ป้าย/หน้า">
<meta name="theme-color" content="#0d1b3e">
<meta name="apple-mobile-web-app-title" content="Rattana Price Tag">
<meta name="mobile-web-app-capable" content="yes">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230d1b3e'/%3E%3Ctext x='50' y='68' font-size='52' text-anchor='middle' fill='%23c9a84c' font-family='Arial' font-weight='bold'%3E฿%3C/text%3E%3C/svg%3E">
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&family=Kanit:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<style>
:root {
  --navy: #0d1b3e;
  --navy-mid: #1a2f5e;
  --navy-light: #243b73;
  --gold: #c9a84c;
  --gold-light: #e8c86a;
  --success: #2ecc71;
  --danger: #e74c3c;
  --warning: #f39c12;
  --info: #3498db;
  --bg: #f4f6fb;
  --text: #0d1b3e;
  --card-bg: #ffffff;
  --border: #dde3f0;
  --muted: #6b7896;
  --row-alt: #fafbfd;
  --space-xs: 4px; --space-sm: 8px; --space-md: 16px; --space-lg: 24px; --space-xl: 32px;
  --radius-sm: 6px; --radius-md: 12px; --radius-lg: 16px; --radius-xl: 20px;
  --shadow-sm: 0 1px 4px rgba(0,0,0,.06);
  --shadow-md: 0 2px 8px rgba(0,0,0,.08);
  --shadow-lg: 0 8px 24px rgba(13,27,62,.12);
  --shadow-gold: 0 4px 12px rgba(201,168,76,.35);
}
body.dark {
  --bg: #0a1020; --text: #e8eaf0; --card-bg: #111c35;
  --border: #243b73; --muted: #8a98b8; --row-alt: #0f1830;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Sarabun',sans-serif;min-height:100dvh;overflow-x:hidden;background:var(--bg);color:var(--text);transition:background .25s,color .25s}
button{font-family:inherit;cursor:pointer;border:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
input,select,textarea{font-family:inherit;font-size:16px}

/* Header */
header{background:var(--navy);color:#fff;padding:12px 16px;position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:12px;border-bottom:3px solid var(--gold);padding-top:max(12px,env(safe-area-inset-top))}
.logo-img{height:38px;width:auto;border-radius:6px;background:#fff;padding:2px}
.logo-text{font-weight:700;letter-spacing:1px;font-size:16px;color:#fff;flex:1;line-height:1.2}
.logo-text small{display:block;font-size:10px;color:var(--gold);font-weight:500;letter-spacing:.5px}
.icon-btn{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.2);width:38px;height:38px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:18px;transition:background .15s}
.icon-btn:hover{background:rgba(255,255,255,.12)}

/* Tab nav */
.tab-nav{display:flex;background:var(--navy);border-bottom:3px solid var(--gold);padding:0 8px;gap:4px;overflow-x:auto;scrollbar-width:none;position:sticky;top:var(--header-h,64px);z-index:99}
.tab-nav::-webkit-scrollbar{display:none}
.tab-btn{background:transparent;border:none;color:rgba(255,255,255,.6);padding:12px 18px;font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap;flex-shrink:0;transition:all .18s;margin-bottom:-3px;border-radius:6px 6px 0 0}
.tab-btn:hover{color:#fff;background:rgba(255,255,255,.06)}
.tab-btn.active{color:var(--navy);background:var(--gold);font-weight:700;box-shadow:0 -2px 8px rgba(201,168,76,.3)}
.tab-btn .badge-count{background:var(--danger);color:#fff;font-size:10px;padding:1px 6px;border-radius:10px;margin-left:4px;font-weight:700}
.tab-btn.active .badge-count{background:var(--navy);color:var(--gold)}

/* Content */
.page{min-height:100dvh;display:flex;flex-direction:column}
.content{flex:1;padding:12px;max-width:1400px;margin:0 auto;width:100%}
@media(min-width:640px){.content{padding:16px}}
.tab-pane{display:none;animation:fadeIn .2s}
.tab-pane.active{display:block}

/* Cards */
.card{background:var(--card-bg);border-radius:var(--radius-md);border:1px solid var(--border);box-shadow:var(--shadow-md);margin-bottom:14px}
.card-gold{border-top:3px solid var(--gold)}
.card-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border);background:linear-gradient(to right,rgba(201,168,76,.07),transparent);gap:8px;flex-wrap:wrap}
.card-head h3{font-size:15px;font-weight:700;display:flex;align-items:center;gap:8px}
.card-body{padding:16px}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:9px 16px;border-radius:var(--radius-sm);font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;border:1px solid transparent;min-height:40px;transition:opacity .15s,transform .1s}
.btn:hover{opacity:.88}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--navy);color:#fff;border-color:var(--navy)}
.btn-gold{background:var(--gold);color:var(--navy);border-color:var(--gold)}
.btn-gold:hover{background:var(--gold-light)}
.btn-outline{background:transparent;color:var(--text);border-color:var(--border)}
.btn-danger{background:var(--danger);color:#fff}
.btn-success{background:var(--success);color:#fff}
.btn-sm{padding:5px 10px;font-size:12px;min-height:30px}
.btn-lg{padding:14px 24px;font-size:15px;min-height:52px;border-radius:var(--radius-md)}
.btn-block{width:100%}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}

/* Inputs */
.field{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}
.field label{font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.3px;text-transform:uppercase}
.input{height:44px;padding:0 14px;border-radius:var(--radius-sm);border:1.5px solid var(--border);background:var(--card-bg);color:var(--text);font-size:16px;font-family:inherit;outline:none;width:100%;transition:border-color .15s}
.input:focus{border-color:var(--gold)}
.input-sm{height:34px;font-size:13px}

/* Stat cards */
.stat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:14px}
@media(min-width:640px){.stat-grid{grid-template-columns:repeat(4,1fr);gap:14px}}
.stat-card{background:var(--card-bg);border-radius:var(--radius-md);padding:14px;border:1px solid var(--border);border-top:3px solid var(--gold)}
.stat-card .s-label{font-size:10px;color:var(--muted);font-weight:600;letter-spacing:.4px;text-transform:uppercase;margin-bottom:4px}
.stat-card .s-value{font-size:22px;font-weight:700;line-height:1.2}
.stat-card .s-sub{font-size:11px;color:var(--muted);margin-top:4px}

/* Filter bar — stack on mobile, row on tablet+ */
.filter-bar{background:var(--card-bg);border-radius:var(--radius-md);padding:10px;margin-bottom:14px;border:1px solid var(--border);display:grid;grid-template-columns:1fr;gap:8px}
.filter-bar > *{min-width:0;max-width:100%!important}
.filter-bar .filter-actions{display:flex;gap:6px;justify-content:flex-end}
@media(min-width:640px){
  .filter-bar{grid-template-columns:2fr 1fr 1fr auto auto;align-items:center}
  .filter-bar .filter-actions{display:contents}
}

/* Product grid — 2 cols on small phones, larger cards on bigger screens */
.prod-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
@media(min-width:480px){.prod-grid{grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px}}
@media(min-width:768px){.prod-grid{grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}}
.prod-card{background:var(--card-bg);border-radius:var(--radius-md);border:2px solid var(--border);padding:10px;cursor:pointer;transition:all .15s;position:relative;display:flex;flex-direction:column}
.prod-card:hover{border-color:var(--gold-light);box-shadow:var(--shadow-md)}
.prod-card.selected{border-color:var(--gold);background:linear-gradient(to bottom,rgba(201,168,76,.08),transparent);box-shadow:var(--shadow-gold)}
.prod-card .p-img{aspect-ratio:1;background:#f0f2f7;border-radius:8px;overflow:hidden;margin-bottom:8px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:36px}
body.dark .prod-card .p-img{background:#1a2440}
.prod-card .p-img img{width:100%;height:100%;object-fit:cover}
.prod-card .p-sku{font-size:10px;color:var(--muted);font-family:'Courier New',monospace;font-weight:600}
.prod-card .p-name{font-size:13px;font-weight:600;line-height:1.3;margin:4px 0;min-height:34px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.prod-card .p-price{font-size:18px;font-weight:800;color:var(--navy);font-family:'Kanit',sans-serif}
body.dark .prod-card .p-price{color:var(--gold)}
.prod-card .p-old{font-size:11px;color:var(--muted);text-decoration:line-through;margin-left:4px}
.prod-card .p-check{position:absolute;top:8px;right:8px;width:26px;height:26px;border-radius:50%;background:#fff;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:14px;color:transparent;font-weight:700}
.prod-card.selected .p-check{background:var(--gold);border-color:var(--gold);color:var(--navy)}
.prod-card .p-badge{position:absolute;top:8px;left:8px;background:var(--danger);color:#fff;font-size:10px;padding:2px 8px;border-radius:10px;font-weight:700}

/* Template picker */
.tpl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}
.tpl-card{border:2px solid var(--border);border-radius:var(--radius-md);padding:10px;cursor:pointer;text-align:center;background:var(--card-bg);transition:all .15s}
.tpl-card:hover{border-color:var(--gold-light)}
.tpl-card.active{border-color:var(--gold);background:rgba(201,168,76,.05);box-shadow:var(--shadow-gold)}
.tpl-preview{aspect-ratio:3/4;border-radius:8px;margin-bottom:6px;overflow:hidden;position:relative;background:#fff;border:1px solid #ddd}
.tpl-card .tpl-name{font-size:12px;font-weight:600}

/* ============== PRICE TAG TEMPLATES ============== */
/* Each tag = 95mm x 138mm (A4 / 4 with margins) */
.tag-stage{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
@media(min-width:1024px){.tag-stage{grid-template-columns:repeat(2,1fr)}}

.tag {
  width:95mm; height:138mm;
  background:#fff; color:#000;
  position:relative; overflow:hidden;
  font-family:'Kanit','Sarabun',sans-serif;
  page-break-inside:avoid;
  border-radius:6px;
  box-shadow:0 4px 12px rgba(0,0,0,.15);
  display:flex; flex-direction:column;
}

/* === Template 1: Regular (ราคาปกติ) — clean white + gold === */
.tpl-regular {
  background:#fff;
  border:3px solid #c9a84c;
}
.tpl-regular .t-head{background:#0d1b3e;color:#fff;padding:6px 10px;text-align:center;font-size:11pt;font-weight:600;letter-spacing:1px}
.tpl-regular .t-img{flex:0 0 38mm;display:flex;align-items:center;justify-content:center;padding:4mm;background:#fafbfd}
.tpl-regular .t-img img{max-width:100%;max-height:100%;object-fit:contain}
.tpl-regular .t-img-empty{color:#bbb;font-size:36pt}
.tpl-regular .t-name{padding:3mm 4mm 1mm;font-size:13pt;font-weight:700;text-align:center;line-height:1.2;color:#0d1b3e;min-height:14mm;display:flex;align-items:center;justify-content:center}
.tpl-regular .t-size{text-align:center;font-size:9pt;color:#666;font-weight:500;margin-bottom:1mm}
.tpl-regular .t-price-box{flex:1;background:#c9a84c;color:#0d1b3e;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2mm}
.tpl-regular .t-price{font-size:42pt;font-weight:800;line-height:1;font-family:'Kanit',sans-serif}
.tpl-regular .t-unit{font-size:11pt;font-weight:600;margin-top:1mm}
.tpl-regular .t-foot{background:#0d1b3e;color:#fff;padding:2mm 3mm;display:flex;justify-content:space-between;align-items:center;font-size:8pt}
.tpl-regular .t-foot .t-sku{font-family:'Courier New',monospace;font-weight:600}
.tpl-regular .t-foot canvas,.tpl-regular .t-foot svg{background:#fff;padding:1mm;border-radius:2px}

/* === Template 2: Sale (ลดราคา) — red/yellow shock === */
.tpl-sale {
  background:linear-gradient(135deg,#fff8e7 0%,#ffe9b3 100%);
  border:3px solid #e74c3c;
}
.tpl-sale .t-head{background:#e74c3c;color:#fff;padding:5mm 3mm;text-align:center;font-size:16pt;font-weight:800;letter-spacing:2px;font-family:'Kanit',sans-serif;position:relative}
.tpl-sale .t-head::after{content:'';position:absolute;bottom:-6px;left:50%;transform:translateX(-50%);border:6px solid transparent;border-top-color:#e74c3c}
.tpl-sale .t-discount-badge{position:absolute;top:8mm;right:4mm;width:22mm;height:22mm;background:#ffeb3b;color:#e74c3c;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;border:3px solid #e74c3c;transform:rotate(15deg);box-shadow:0 2px 6px rgba(0,0,0,.2);z-index:5}
.tpl-sale .t-discount-badge .pct{font-size:18pt;line-height:1;font-family:'Kanit',sans-serif}
.tpl-sale .t-discount-badge .off{font-size:8pt;line-height:1;margin-top:1mm}
.tpl-sale .t-img{flex:0 0 32mm;display:flex;align-items:center;justify-content:center;padding:3mm;margin-top:3mm}
.tpl-sale .t-img img{max-width:100%;max-height:100%;object-fit:contain}
.tpl-sale .t-img-empty{color:#e74c3c44;font-size:32pt}
.tpl-sale .t-name{padding:2mm 4mm;font-size:12pt;font-weight:700;text-align:center;line-height:1.2;color:#0d1b3e;min-height:12mm}
.tpl-sale .t-size{text-align:center;font-size:9pt;color:#666;font-weight:500}
.tpl-sale .t-old{text-align:center;font-size:11pt;color:#888;text-decoration:line-through;margin:1mm 0;font-weight:500}
.tpl-sale .t-price-box{flex:1;text-align:center;padding:1mm}
.tpl-sale .t-price{font-size:44pt;font-weight:800;color:#e74c3c;line-height:1;font-family:'Kanit',sans-serif;text-shadow:1px 1px 0 #fff,2px 2px 0 rgba(0,0,0,.1)}
.tpl-sale .t-unit{font-size:11pt;font-weight:600;color:#0d1b3e}
.tpl-sale .t-foot{background:#0d1b3e;color:#fff;padding:2mm 3mm;display:flex;justify-content:space-between;align-items:center;font-size:8pt}
.tpl-sale .t-foot canvas,.tpl-sale .t-foot svg{background:#fff;padding:1mm;border-radius:2px}

/* === Template 3: New / Recommended (สินค้าใหม่) — fresh green === */
.tpl-new {
  background:linear-gradient(135deg,#e8f7ee 0%,#c8efd6 100%);
  border:3px solid #2ecc71;
}
.tpl-new .t-head{background:#2ecc71;color:#fff;padding:4mm 3mm;text-align:center;font-size:14pt;font-weight:800;letter-spacing:2px;font-family:'Kanit',sans-serif}
.tpl-new .t-new-badge{position:absolute;top:6mm;left:3mm;background:#e74c3c;color:#fff;padding:2mm 4mm;font-size:11pt;font-weight:800;font-family:'Kanit',sans-serif;border-radius:4px;transform:rotate(-8deg);box-shadow:0 2px 4px rgba(0,0,0,.2);z-index:5;letter-spacing:1px}
.tpl-new .t-img{flex:0 0 42mm;display:flex;align-items:center;justify-content:center;padding:3mm;background:rgba(255,255,255,.6);margin:3mm;border-radius:8px}
.tpl-new .t-img img{max-width:100%;max-height:100%;object-fit:contain}
.tpl-new .t-img-empty{color:#2ecc71;font-size:36pt;opacity:.4}
.tpl-new .t-name{padding:0 4mm 1mm;font-size:13pt;font-weight:700;text-align:center;line-height:1.2;color:#0d1b3e;min-height:14mm}
.tpl-new .t-size{text-align:center;font-size:9pt;color:#1e8449;font-weight:600}
.tpl-new .t-price-box{flex:1;background:#fff;margin:2mm 3mm;border-radius:8px;border:2px dashed #2ecc71;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2mm}
.tpl-new .t-price{font-size:38pt;font-weight:800;color:#0d1b3e;line-height:1;font-family:'Kanit',sans-serif}
.tpl-new .t-unit{font-size:10pt;font-weight:600;color:#2ecc71;margin-top:1mm}
.tpl-new .t-foot{background:#0d1b3e;color:#fff;padding:2mm 3mm;display:flex;justify-content:space-between;align-items:center;font-size:8pt}
.tpl-new .t-foot canvas,.tpl-new .t-foot svg{background:#fff;padding:1mm;border-radius:2px}

/* === Template 4: BOGO / Buy Pair (ซื้อ 1 แถม 1) — bold blue === */
.tpl-bogo {
  background:linear-gradient(135deg,#e3f0fd 0%,#a8d4f7 100%);
  border:3px solid #1a6fb8;
}
.tpl-bogo .t-head{background:#1a6fb8;color:#fff;padding:4mm 2mm;text-align:center;font-size:18pt;font-weight:800;font-family:'Kanit',sans-serif;letter-spacing:1px;line-height:1}
.tpl-bogo .t-head .sub{font-size:9pt;font-weight:500;letter-spacing:2px;margin-top:1mm;display:block}
.tpl-bogo .t-promo-banner{background:#ffeb3b;color:#0d1b3e;text-align:center;padding:3mm 2mm;font-size:14pt;font-weight:800;font-family:'Kanit',sans-serif;border-bottom:2px solid #1a6fb8;letter-spacing:1px}
.tpl-bogo .t-img{flex:0 0 32mm;display:flex;align-items:center;justify-content:center;padding:3mm}
.tpl-bogo .t-img img{max-width:100%;max-height:100%;object-fit:contain}
.tpl-bogo .t-img-empty{color:#1a6fb888;font-size:32pt}
.tpl-bogo .t-name{padding:1mm 4mm;font-size:12pt;font-weight:700;text-align:center;line-height:1.2;color:#0d1b3e;min-height:12mm}
.tpl-bogo .t-size{text-align:center;font-size:9pt;color:#666;font-weight:500}
.tpl-bogo .t-price-box{flex:1;text-align:center;padding:1mm}
.tpl-bogo .t-price{font-size:38pt;font-weight:800;color:#1a6fb8;line-height:1;font-family:'Kanit',sans-serif}
.tpl-bogo .t-unit{font-size:10pt;font-weight:600;color:#0d1b3e}
.tpl-bogo .t-foot{background:#0d1b3e;color:#fff;padding:2mm 3mm;display:flex;justify-content:space-between;align-items:center;font-size:8pt}
.tpl-bogo .t-foot canvas,.tpl-bogo .t-foot svg{background:#fff;padding:1mm;border-radius:2px}

/* Tag wrapper for preview */
.tag-wrap{position:relative;background:var(--card-bg);border-radius:var(--radius-md);padding:12px;border:1px solid var(--border)}
.tag-wrap .tag-overlay{position:absolute;top:8px;right:8px;display:flex;gap:6px;z-index:10}
.tag-wrap .tag-tpl-pick{display:flex;gap:4px;flex-wrap:wrap;margin-top:8px;justify-content:center}
.tag-wrap .tpl-btn{padding:4px 10px;font-size:11px;border-radius:6px;border:1.5px solid var(--border);background:var(--card-bg);color:var(--text);cursor:pointer;font-weight:600;font-family:inherit}
.tag-wrap .tpl-btn.active{background:var(--gold);color:var(--navy);border-color:var(--gold)}
.tag-wrap .tag-scale{transform-origin:top left;transform:scale(0.6);width:166%;height:0;padding-bottom:148%}
@media(max-width:520px){.tag-wrap .tag-scale{transform:scale(0.5);width:200%;padding-bottom:153%}}

/* Modal */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(13,27,62,.65);z-index:9000;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(4px);overflow-y:auto}
.modal-overlay.open{display:flex}
.modal{background:var(--card-bg);border-radius:var(--radius-lg);max-width:560px;width:100%;max-height:92dvh;overflow-y:auto;border-top:4px solid var(--gold);animation:slideUp .22s ease}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border)}
.modal-head h3{font-size:16px;font-weight:700}
.modal-close{background:transparent;border:none;font-size:24px;color:var(--muted);cursor:pointer;padding:4px 8px;border-radius:6px;line-height:1}
.modal-body{padding:20px}
.modal-foot{padding:12px 20px;border-top:1px solid var(--border);display:flex;gap:8px;justify-content:flex-end}

/* Toast */
.toast{position:fixed;bottom:max(24px,env(safe-area-inset-bottom));right:16px;padding:12px 20px;border-radius:var(--radius-md);color:#fff;z-index:9999;animation:slideIn .3s ease;font-weight:500;box-shadow:var(--shadow-lg);max-width:90vw;font-size:13px}
.toast-success{background:var(--success)}
.toast-error{background:var(--danger)}
.toast-warning{background:var(--warning);color:var(--navy)}
.toast-info{background:var(--navy-mid);border-left:3px solid var(--gold)}

/* Spinner */
.spinner-overlay{display:none;position:fixed;inset:0;background:rgba(13,27,62,.55);align-items:center;justify-content:center;z-index:99999;backdrop-filter:blur(3px)}
.spinner-overlay.show{display:flex}
.spinner-box{background:#fff;border-radius:var(--radius-lg);padding:32px 40px;text-align:center;border-top:4px solid var(--gold);min-width:240px}
.spinner-ring{width:48px;height:48px;border:5px solid #dde3f0;border-top-color:var(--gold);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 14px}
body.dark .spinner-box{background:var(--card-bg)}

/* Back to top */
#backToTop{position:fixed;bottom:max(24px,calc(16px + env(safe-area-inset-bottom)));right:max(16px,calc(12px + env(safe-area-inset-right)));background:var(--gold);color:var(--navy);border:none;border-radius:50%;width:46px;height:46px;display:none;align-items:center;justify-content:center;box-shadow:var(--shadow-gold);z-index:90;font-size:18px;font-weight:700;cursor:pointer}
#backToTop.show{display:flex}

/* Login screen */
#loginScreen{position:fixed;inset:0;background:linear-gradient(135deg,var(--navy) 0%,#1a2f5e 100%);display:flex;align-items:center;justify-content:center;padding:20px;z-index:1000}
.login-card{background:#fff;border-radius:var(--radius-lg);padding:40px 32px;max-width:420px;width:100%;text-align:center;border-top:5px solid var(--gold);box-shadow:0 20px 60px rgba(0,0,0,.3)}
.login-card .login-logo{height:80px;margin:0 auto 16px;display:block}
.login-card h1{color:var(--navy);font-size:24px;margin-bottom:6px;font-family:'Kanit',sans-serif;font-weight:700}
.login-card .subtitle{color:var(--muted);font-size:13px;margin-bottom:24px}
.login-card .g-id-signin{display:inline-block}
.login-err{color:var(--danger);font-size:13px;margin-top:12px;min-height:20px}

/* Animations */
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes slideIn{from{transform:translateX(120%);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

/* Utility */
.flex{display:flex}.flex-center{display:flex;align-items:center;justify-content:center}.flex-between{display:flex;align-items:center;justify-content:space-between}
.gap-4{gap:4px}.gap-8{gap:8px}.gap-12{gap:12px}
.mt-8{margin-top:8px}.mt-12{margin-top:12px}.mt-16{margin-top:16px}
.txt-muted{color:var(--muted)}.txt-bold{font-weight:700}.txt-center{text-align:center}
.hidden{display:none!important}
.empty-state{text-align:center;padding:60px 20px;color:var(--muted)}
.empty-state .emoji{font-size:48px;margin-bottom:12px}
.empty-state h3{font-size:16px;margin-bottom:6px;color:var(--text)}

/* PDF preview area */
.pdf-stage{display:flex;flex-direction:column;gap:14px;align-items:center;overflow-x:auto}
.pdf-page{background:#fff;width:210mm;min-height:297mm;padding:8mm;display:grid;grid-template-columns:repeat(2,1fr);grid-template-rows:repeat(2,1fr);gap:6mm;box-shadow:0 8px 24px rgba(0,0,0,.15);page-break-after:always;flex-shrink:0}
.pdf-page .tag{margin:auto}
.pdf-wrap{position:relative;overflow:hidden;border-radius:8px;background:#e8eaf0;padding:10px}
.pdf-wrap-inner{transform-origin:top left}
@media(max-width:880px){.pdf-wrap-inner{transform:scale(0.42)}}
@media(min-width:881px) and (max-width:1100px){.pdf-wrap-inner{transform:scale(0.65)}}
@media(min-width:1101px){.pdf-wrap-inner{transform:scale(0.85)}}

/* Help block */
.help-block{background:rgba(52,152,219,.08);border-left:3px solid var(--info);padding:12px 14px;border-radius:6px;font-size:13px;color:var(--text);margin-bottom:14px;line-height:1.6}
.help-block code{background:var(--card-bg);padding:1px 6px;border-radius:4px;font-family:'Courier New',monospace;font-size:12px;border:1px solid var(--border)}
.help-block ul{margin:6px 0 0 18px}
.help-block li{margin-bottom:2px}

/* Column-map field row */
.cmap-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:520px){.cmap-grid{grid-template-columns:1fr}}
</style>
