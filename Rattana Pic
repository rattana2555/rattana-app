/* Google Drive URL → browser-displayable.
   Uses lh3.googleusercontent.com (works for cross-origin img tags + html2canvas) */
function fixImageUrl(url) {
  url = String(url||'').trim();
  if (!url) return '';
  if (url.includes('drive.google.com') || url.includes('googleusercontent.com')) {
    const m = url.match(/[?&]id=([a-zA-Z0-9_-]+)/)
           || url.match(/\/d\/([a-zA-Z0-9_-]+)/)
           || url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
    if (m) return `https://lh3.googleusercontent.com/d/${m[1]}=w600`;
  }
  return url;
}

/* Normalize row → standard product object */
function normalizeProduct(r) {
  // Detect PDDT (Rattana Master) format
  const isPDDT = ('PRODUCT NAME' in r) && (('CODE EA' in r) || ('CODE CS' in r));
  if (isPDDT) return normalizePDDT(r);

  // Generic format
  const get = (...keys) => {
    for (const k of keys) {
      if (r[k] != null && String(r[k]).trim() !== '') return String(r[k]).trim();
    }
    return '';
  };
  const sku   = get('รหัสสินค้า','SKU','sku','รหัส','Code');
  const name  = get('ชื่อสินค้า','ชื่อ','Name','name','Product');
  const price = parseFloat(get('ราคา','ราคาขาย','Price','price').replace(/,/g,'')) || 0;
  const oldPrice = parseFloat(get('ราคาเดิม','ราคาก่อนลด','OldPrice').replace(/,/g,'')) || 0;
  const unit  = get('หน่วย','Unit','unit') || 'บาท';
  const size  = get('ขนาด','ปริมาณ','Size','size');
  const image = fixImageUrl(get('รูปภาพ','รูป','Image','image','URL'));
  const barcode = get('บาร์โค้ด','Barcode','barcode','EAN');
  const tagTypeRaw = get('ประเภทป้าย','ประเภท','TagType','Type').toLowerCase();
  const promo = get('โปรโมชั่น','โปร','Promo','promo');
  const category = get('หมวดหมู่','หมวด','Category','category');

  let tagType = 'regular';
  if (/ลด|sale|discount/i.test(tagTypeRaw))           tagType = 'sale';
  else if (/ใหม่|new|recommend|แนะนำ/i.test(tagTypeRaw)) tagType = 'new';
  else if (/แถม|bogo|คู่|pair/i.test(tagTypeRaw))     tagType = 'bogo';
  else if (oldPrice > price)                          tagType = 'sale';

  return { sku, name, price, oldPrice, unit, size, image, barcode, tagType, promo, category };
}

/* Normalize PDDT (Rattana master) row */
function normalizePDDT(r) {
  const tier = ($('#cfgPriceTier') && $('#cfgPriceTier').value) || 'CC00';
  const prefStr = ($('#cfgUnitPref') && $('#cfgUnitPref').value) || 'EA,PA,BP,CS';
  const preferred = prefStr.split(',').map(s => s.trim()).filter(Boolean);

  // Pick first preferred unit that has BOTH a code AND a price
  let sku = '', price = 0, unit = 'บาท', usedUnit = '';
  for (const u of preferred) {
    const code = String(r[`CODE ${u}`]||'').trim();
    const priceRaw = String(r[`PRICE ${tier} ${u}`]||'').replace(/,/g,'').trim();
    const p = parseFloat(priceRaw);
    if (code && !isNaN(p) && p > 0) {
      sku = code;
      price = p;
      const unitDesc = String(r[`UNIT ${u}`]||'').trim();
      unit = unitDesc || u;
      usedUnit = u;
      break;
    }
  }
  // Fallback: any unit with at least a code (no price)
  if (!sku) {
    for (const u of preferred) {
      const code = String(r[`CODE ${u}`]||'').trim();
      if (code) {
        sku = code;
        unit = String(r[`UNIT ${u}`]||'').trim() || u;
        usedUnit = u;
        break;
      }
    }
  }

  const name = String(r['SHORT NAME']||'').trim() || String(r['PRODUCT NAME']||'').trim();
  const size = String(r['CAT SIZE']||'').trim();
  const category = String(r['CAT GROUP']||r['CAT TYPE']||'').trim();
  const brand = String(r['CAT BRAND']||'').trim();
  const image = fixImageUrl(r['SKU_USAGE']||'');
  const barcode = sku; // CODE EA/CS look like barcodes

  return {
    sku, name, price, oldPrice: 0, unit, size, image, barcode,
    tagType: 'regular', promo: '', category, brand, usedUnit
  };
}

