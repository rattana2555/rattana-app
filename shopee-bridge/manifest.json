{
  "manifest_version": 3,
  "name": "Rattana Chat Hub — Bridge",
  "version": "3.0.0",
  "description": "อ่านแชท Shopee / LINE OA / TikTok จากหน้าที่เปิดอยู่ แล้วส่งเข้า Rattana Chat Hub (อ่านอย่างเดียว ไม่ตอบแทน)",
  "permissions": [
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://seller.shopee.co.th/*",
    "https://manager.line.biz/*",
    "https://chat.line.biz/*",
    "https://seller-th.tiktok.com/*",
    "https://seller.tiktok.com/*",
    "https://seller-us.tiktok.com/*",
    "https://www.tiktok.com/*",
    "https://tsudgtzcskoopbymklfg.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://seller.shopee.co.th/*",
        "https://manager.line.biz/*",
        "https://chat.line.biz/*",
        "https://seller-th.tiktok.com/*",
        "https://seller.tiktok.com/*",
        "https://seller-us.tiktok.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://seller.shopee.co.th/*",
        "https://manager.line.biz/*",
        "https://chat.line.biz/*",
        "https://seller-th.tiktok.com/*",
        "https://seller.tiktok.com/*",
        "https://seller-us.tiktok.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Rattana Chat Hub — Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
