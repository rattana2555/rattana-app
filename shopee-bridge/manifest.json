{
  "manifest_version": 3,
  "name": "Rattana Chat Hub — Shopee Bridge",
  "version": "1.0.0",
  "description": "อ่านแชท Shopee Seller Center จากหน้าที่เปิดอยู่ แล้วส่งเข้า Rattana Chat Hub (อ่านอย่างเดียว ไม่ตอบแทน)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://seller.shopee.co.th/*",
    "https://tsudgtzcskoopbymklfg.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://seller.shopee.co.th/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://seller.shopee.co.th/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Rattana Chat Hub — Shopee Bridge",
    "default_popup": "popup.html"
  }
}
